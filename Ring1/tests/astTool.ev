package ring1.tests

// Prints the syntax tree Ring1's parser builds for the file named by the first argument, in the format of Ring0's
// `--ast`. The parser corpus script compares the two.
static method<Int> main {
    String source = readFile(argument(0))

    if (source.length() == 0) {
        return 1
    }

    println(dumpSource(source))
    return 0
}
