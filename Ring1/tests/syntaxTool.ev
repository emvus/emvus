package ring1.tests

// Prints the syntax errors Ring1's parser finds in the file named by the first argument, in the format of Ring0's
// error output. The syntax-error corpus script compares the two.
static method<Int> main {
    String source = readFile(argument(0))

    if (source.length() == 0) {
        return 1
    }

    print(syntaxErrors(source))
    return 0
}
