package main

import os
import path
import strings

// Generates a parser test from Emvus sources, with Ring0's parser as the oracle:
//
//   novusc run generateParserCases.nv <ring0-binary> <out.ev> <file.ev>...
//
// Every source Ring0 accepts becomes one test case that parses it with Ring1 and compares the
// printed tree with Ring0's. Sources with string interpolation are skipped: Ring1 does not parse
// the expressions inside `${...}` yet.

method main(array<string> arguments) {
    if (arguments.length() < 3) {
        println "usage: generateParserCases.nv <ring0-binary> <out.ev> <file.ev>..."
        return 1
    }

    var cases = []
    var skipped = 0
    var index = 2
    while (index < arguments.length()) {
        var generated = caseFor(arguments[0], arguments[index], cases.length())
        if (generated == "") {
            skipped = skipped + 1
        }

        if (generated != "") {
            cases.append(generated)
        }

        index = index + 1
    }

    os.writeFile(arguments[1], testFile(cases))
    println "cases: " + cases.length() + ", skipped: " + skipped
    return 0
}

// One test case, or "" when Ring0 rejects the source or it uses interpolation.
method caseFor(string ring0, string file, integer number): string {
    var source = os.readFile(file)
    if (source.contains("${") || source.contains("$(")) {
        return ""
    }

    var result = os.run(os.shellQuote(ring0) + " " + os.shellQuote(file) + " 2>/dev/null")
    if (result["code"] != 0) {
        return ""
    }

    var expected = result["output"]
    expected = expected.substring(0, expected.length() - 1)
    var name = "case" + padNumber(number) + "_" + path.stem(file)
    return "static method<Int> " + name + "() {\n    return expectDump(" + literal(source) + ", " + literal(expected) + ")\n}\n"
}

method padNumber(integer number): string {
    return strings.padLeftWith("" + number, 3, "0")
}

method literal(string text): string {
    var result = "\""
    var index = 0
    while (index < text.length()) {
        result = result + escaped(text.charAt(index))
        index = index + 1
    }

    return result + "\""
}

method escaped(string character): string {
    if (character == "\\") {
        return "\\\\"
    }

    if (character == "\"") {
        return "\\\""
    }

    if (character == "\n") {
        return "\\n"
    }

    if (character == "\r") {
        return "\\r"
    }

    if (character == "\t") {
        return "\\t"
    }

    return character
}

method testFile(array<string> cases): string {
    var text = "package ring1.parser\n\n"
    text = text + "// Generated by scripts/generateParserCases.nv from Ring0's test sources; do not edit.\n"
    text = text + "final var CASE_PASSED = 0\nfinal var CASE_FAILED = 1\n\n"
    text = text + "static method<Int> expectDump(String source, String expected) {\n"
    text = text + "    if (dumpSource(source) != expected) {\n        return CASE_FAILED\n    }\n\n    return CASE_PASSED\n}\n\n"
    var names = []
    for (generated in cases) {
        text = text + generated + "\n"
        names.append(generated.substring(("static method<Int> ").length(), generated.indexOf("(")))
    }

    text = text + "// Returns the number of failed cases, so 0 means every case passed.\nstatic method<Int> main {\n    Int failed = 0\n"
    for (name in names) {
        text = text + "    failed = failed + " + name + "()\n"
    }

    return text + "    return failed\n}\n"
}
