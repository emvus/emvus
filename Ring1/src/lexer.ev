package ring1.lexer

// Ring1 lexer v0 in the parameter-passing subset (Ring0/docs/languageDecisions.md, decision 3).
// A token is a span of the source in UTF-8 bytes, so columns count bytes and a string token keeps
// its quotes and escapes raw. Lexical errors are tokens of their own kind where Ring0 reports a
// diagnostic. State lives in two lists because the subset has no list-typed fields.

final var TOKEN_EOF = 0
final var TOKEN_IDENTIFIER = 1
final var TOKEN_KEYWORD = 2
final var TOKEN_NUMBER = 3
final var TOKEN_FLOAT = 4
final var TOKEN_STRING = 5
final var TOKEN_SYMBOL = 6
final var TOKEN_UNEXPECTED = 8
final var TOKEN_UNTERMINATED_STRING = 9
final var TOKEN_UNTERMINATED_COMMENT = 10

final var TOKEN_KIND = 0
final var TOKEN_START = 1
final var TOKEN_LENGTH = 2
final var TOKEN_LINE = 3
final var TOKEN_COLUMN = 4
final var TOKEN_STRIDE = 5

final var AHEAD_CURRENT = 0
final var AHEAD_NEXT = 1
final var AHEAD_THIRD = 2
final var FIRST_LINE = 1
final var FIRST_COLUMN = 1
final var FIRST_POSITION = 0
final var SYMBOL_NONE = 0
final var SYMBOL_SINGLE = 1
final var SYMBOL_DOUBLE = 2
final var SYMBOL_TRIPLE = 3
final var EXPECTED_KIND = 0
final var EXPECTED_LENGTH = 1
final var EXPECTED_STRIDE = 2
final var CASE_PASSED = 0
final var CASE_FAILED = 1
final var CURSOR_POSITION = 0
final var CURSOR_LINE = 1
final var CURSOR_LINE_START = 2
final var NO_BYTE = -1

final var BYTE_TAB = 9
final var BYTE_NEWLINE = 10
final var BYTE_RETURN = 13
final var BYTE_SPACE = 32
final var BYTE_BANG = 33
final var BYTE_QUOTE = 34
final var BYTE_DOLLAR = 36
final var BYTE_PERCENT = 37
final var BYTE_AMPERSAND = 38
final var BYTE_OPEN_PAREN = 40
final var BYTE_CLOSE_PAREN = 41
final var BYTE_STAR = 42
final var BYTE_PLUS = 43
final var BYTE_MINUS = 45
final var BYTE_DOT = 46
final var BYTE_SLASH = 47
final var BYTE_ZERO = 48
final var BYTE_NINE = 57
final var BYTE_LESS = 60
final var BYTE_EQUALS = 61
final var BYTE_GREATER = 62
final var BYTE_UPPER_A = 65
final var BYTE_UPPER_E = 69
final var BYTE_UPPER_Z = 90
final var BYTE_BACKSLASH = 92
final var BYTE_UNDERSCORE = 95
final var BYTE_LOWER_A = 97
final var BYTE_LOWER_E = 101
final var BYTE_LOWER_Z = 122
final var BYTE_OPEN_BRACE = 123
final var BYTE_PIPE = 124
final var BYTE_CLOSE_BRACE = 125

static method<Int> peek(String source, List<Int> cursor, Int ahead) {
    Int position = cursor[CURSOR_POSITION] + ahead

    if (position >= source.length()) {
        return NO_BYTE
    }

    return source.byteAt(position)
}

static method advance(String source, List<Int> cursor) {
    Int position = cursor[CURSOR_POSITION]

    if (source.byteAt(position) == BYTE_NEWLINE) {
        cursor[CURSOR_LINE] = cursor[CURSOR_LINE] + 1
        cursor[CURSOR_LINE_START] = position + 1
    }

    cursor[CURSOR_POSITION] = position + 1
}

static method<Int> columnAt(List<Int> cursor) {
    return cursor[CURSOR_POSITION] - cursor[CURSOR_LINE_START] + FIRST_COLUMN
}

static method emit(List<Int> tokens, Int kind, Int start, Int length, Int line, Int column) {
    tokens.add(kind)
    tokens.add(start)
    tokens.add(length)
    tokens.add(line)
    tokens.add(column)
}

static method<Bool> isDigit(Int value) {
    return value >= BYTE_ZERO && value <= BYTE_NINE
}

static method<Bool> isLetter(Int value) {
    return (value >= BYTE_UPPER_A && value <= BYTE_UPPER_Z) || (value >= BYTE_LOWER_A && value <= BYTE_LOWER_Z)
}

static method<Bool> isIdentifierStart(Int value) {
    return isLetter(value) || value == BYTE_UNDERSCORE
}

static method<Bool> isIdentifierPart(Int value) {
    return isIdentifierStart(value) || isDigit(value)
}

static method<Bool> isWhitespace(Int value) {
    return value == BYTE_SPACE || value == BYTE_TAB || value == BYTE_RETURN || value == BYTE_NEWLINE
}

static method<Bool> isKeyword(String word) {
    return isDeclarationKeyword(word) || isModifierKeyword(word) || isControlKeyword(word) || isValueKeyword(word)
}

static method<Bool> isDeclarationKeyword(String word) {
    return word == "package" || word == "use" || word == "var" || word == "dynamic" || word == "enum" || word == "record" || word == "class" || word == "interface" || word == "exception" || word == "method" || word == "macro"
}

static method<Bool> isModifierKeyword(String word) {
    return word == "final" || word == "static" || word == "abstract" || word == "override" || word == "private" || word == "protected" || word == "public" || word == "scoped"
}

static method<Bool> isControlKeyword(String word) {
    return word == "if" || word == "while" || word == "for" || word == "in" || word == "switch" || word == "return" || word == "fail" || word == "break" || word == "continue"
}

static method<Bool> isValueKeyword(String word) {
    return word == "true" || word == "false" || word == "null" || word == "this" || word == "super" || word == "is" || word == "as" || word == "fiber" || word == "virtual" || word == "thread"
}

static method<Bool> skipTrivia(String source, List<Int> cursor, List<Int> tokens) {
    Int current = peek(source, cursor, AHEAD_CURRENT)
    Int following = peek(source, cursor, AHEAD_NEXT)

    if (isWhitespace(current)) {
        advance(source, cursor)
        return true
    }

    if (current == BYTE_SLASH && following == BYTE_SLASH) {
        skipLineComment(source, cursor)
        return true
    }

    if (current == BYTE_SLASH && following == BYTE_STAR) {
        skipBlockComment(source, cursor, tokens)
        return true
    }

    return false
}

static method skipLineComment(String source, List<Int> cursor) {
    while (peek(source, cursor, AHEAD_CURRENT) != NO_BYTE && peek(source, cursor, AHEAD_CURRENT) != BYTE_NEWLINE) {
        advance(source, cursor)
    }
}

static method skipBlockComment(String source, List<Int> cursor, List<Int> tokens) {
    Int start = cursor[CURSOR_POSITION]
    Int line = cursor[CURSOR_LINE]
    Int column = columnAt(cursor)
    advance(source, cursor)
    advance(source, cursor)

    while (peek(source, cursor, AHEAD_CURRENT) != NO_BYTE) {
        if (peek(source, cursor, AHEAD_CURRENT) == BYTE_STAR && peek(source, cursor, AHEAD_NEXT) == BYTE_SLASH) {
            advance(source, cursor)
            advance(source, cursor)
            return
        }

        advance(source, cursor)
    }

    emit(tokens, TOKEN_UNTERMINATED_COMMENT, start, cursor[CURSOR_POSITION] - start, line, column)
}

static method lexIdentifier(String source, List<Int> cursor, List<Int> tokens) {
    Int start = cursor[CURSOR_POSITION]
    Int line = cursor[CURSOR_LINE]
    Int column = columnAt(cursor)

    while (isIdentifierPart(peek(source, cursor, AHEAD_CURRENT))) {
        advance(source, cursor)
    }

    Int end = cursor[CURSOR_POSITION]
    Int kind = TOKEN_IDENTIFIER

    if (isKeyword(source.substring(start, end))) {
        kind = TOKEN_KEYWORD
    }

    emit(tokens, kind, start, end - start, line, column)
}

static method skipDigits(String source, List<Int> cursor) {
    while (isDigit(peek(source, cursor, AHEAD_CURRENT))) {
        advance(source, cursor)
    }
}

// A `.` only starts a fraction when a digit follows, so `1..x` and `1.method()` stay intact.
static method<Bool> startsFraction(String source, List<Int> cursor) {
    return peek(source, cursor, AHEAD_CURRENT) == BYTE_DOT && isDigit(peek(source, cursor, AHEAD_NEXT))
}

// An `e` without digits behind it is not an exponent: it belongs to the next token.
static method<Bool> startsExponent(String source, List<Int> cursor) {
    Int current = peek(source, cursor, AHEAD_CURRENT)

    if (current != BYTE_LOWER_E && current != BYTE_UPPER_E) {
        return false
    }

    Int after = peek(source, cursor, AHEAD_NEXT)
    Bool signed = after == BYTE_PLUS || after == BYTE_MINUS
    return isDigit(after) || (signed && isDigit(peek(source, cursor, AHEAD_THIRD)))
}

static method skipExponent(String source, List<Int> cursor) {
    advance(source, cursor)
    Int sign = peek(source, cursor, AHEAD_CURRENT)

    if (sign == BYTE_PLUS || sign == BYTE_MINUS) {
        advance(source, cursor)
    }

    skipDigits(source, cursor)
}

static method lexNumber(String source, List<Int> cursor, List<Int> tokens) {
    Int start = cursor[CURSOR_POSITION]
    Int line = cursor[CURSOR_LINE]
    Int column = columnAt(cursor)
    Int kind = TOKEN_NUMBER
    skipDigits(source, cursor)

    if (startsFraction(source, cursor)) {
        advance(source, cursor)
        skipDigits(source, cursor)
        kind = TOKEN_FLOAT
    }

    if (startsExponent(source, cursor)) {
        skipExponent(source, cursor)
        kind = TOKEN_FLOAT
    }

    emit(tokens, kind, start, cursor[CURSOR_POSITION] - start, line, column)
}

static method lexString(String source, List<Int> cursor, List<Int> tokens) {
    Int start = cursor[CURSOR_POSITION]
    Int line = cursor[CURSOR_LINE]
    Int column = columnAt(cursor)
    advance(source, cursor)

    while (peek(source, cursor, AHEAD_CURRENT) != NO_BYTE && peek(source, cursor, AHEAD_CURRENT) != BYTE_QUOTE) {
        Int current = peek(source, cursor, AHEAD_CURRENT)

        if (current == BYTE_BACKSLASH) {
            skipEscape(source, cursor)
            continue
        }

        if (current == BYTE_DOLLAR && opensInterpolation(peek(source, cursor, AHEAD_NEXT))) {
            skipInterpolation(source, cursor)
            continue
        }

        advance(source, cursor)
    }

    if (peek(source, cursor, AHEAD_CURRENT) == NO_BYTE) {
        emit(tokens, TOKEN_UNTERMINATED_STRING, start, cursor[CURSOR_POSITION] - start, line, column)
        return
    }

    advance(source, cursor)
    emit(tokens, TOKEN_STRING, start, cursor[CURSOR_POSITION] - start, line, column)
}

static method<Bool> opensInterpolation(Int value) {
    return value == BYTE_OPEN_BRACE || value == BYTE_OPEN_PAREN
}

static method skipEscape(String source, List<Int> cursor) {
    advance(source, cursor)

    if (peek(source, cursor, AHEAD_CURRENT) != NO_BYTE) {
        advance(source, cursor)
    }
}

static method skipInterpolation(String source, List<Int> cursor) {
    advance(source, cursor)
    Int open = peek(source, cursor, AHEAD_CURRENT)
    advance(source, cursor)
    Int close = BYTE_CLOSE_BRACE

    if (open == BYTE_OPEN_PAREN) {
        close = BYTE_CLOSE_PAREN
    }

    Int depth = 1

    while (peek(source, cursor, AHEAD_CURRENT) != NO_BYTE && depth > 0) {
        Int value = peek(source, cursor, AHEAD_CURRENT)
        advance(source, cursor)

        if (value == open) {
            depth = depth + 1
        }

        if (value == close) {
            depth = depth - 1
        }

        if (value == BYTE_QUOTE) {
            skipQuotedRemainder(source, cursor)
        }
    }
}

static method skipQuotedRemainder(String source, List<Int> cursor) {
    while (peek(source, cursor, AHEAD_CURRENT) != NO_BYTE && peek(source, cursor, AHEAD_CURRENT) != BYTE_QUOTE) {
        Int inner = peek(source, cursor, AHEAD_CURRENT)
        advance(source, cursor)

        if (inner == BYTE_BACKSLASH && peek(source, cursor, AHEAD_CURRENT) != NO_BYTE) {
            advance(source, cursor)
        }
    }

    if (peek(source, cursor, AHEAD_CURRENT) != NO_BYTE) {
        advance(source, cursor)
    }
}

static method<String> singleSymbols() {
    return "(){}[];,.=+-*/%!<>@$:?&|"
}

static method<Bool> isThreeByteSymbol(Int first, Int second, Int third) {
    return first == BYTE_DOT && second == BYTE_DOT && third == BYTE_DOT
}

static method<Bool> isTwoByteSymbol(Int first, Int second) {
    if (second == BYTE_EQUALS) {
        return first == BYTE_EQUALS || first == BYTE_BANG || first == BYTE_LESS || first == BYTE_GREATER || first == BYTE_PLUS || first == BYTE_MINUS || first == BYTE_STAR || first == BYTE_SLASH || first == BYTE_PERCENT
    }

    if (first == BYTE_MINUS && second == BYTE_GREATER) {
        return true
    }

    return first == second && (first == BYTE_AMPERSAND || first == BYTE_PIPE || first == BYTE_PLUS || first == BYTE_MINUS || first == BYTE_DOT)
}

static method<Bool> isSingleSymbol(String source, List<Int> cursor) {
    Int position = cursor[CURSOR_POSITION]
    return singleSymbols().indexOf(source.substring(position, position + 1)) >= 0
}

static method<Int> symbolLength(String source, List<Int> cursor) {
    Int first = peek(source, cursor, AHEAD_CURRENT)
    Int second = peek(source, cursor, AHEAD_NEXT)

    if (isThreeByteSymbol(first, second, peek(source, cursor, AHEAD_THIRD))) {
        return SYMBOL_TRIPLE
    }

    if (isTwoByteSymbol(first, second)) {
        return SYMBOL_DOUBLE
    }

    if (isSingleSymbol(source, cursor)) {
        return SYMBOL_SINGLE
    }

    return SYMBOL_NONE
}

static method lexSymbol(String source, List<Int> cursor, List<Int> tokens) {
    Int start = cursor[CURSOR_POSITION]
    Int line = cursor[CURSOR_LINE]
    Int column = columnAt(cursor)
    Int length = symbolLength(source, cursor)
    Int kind = TOKEN_SYMBOL
    Int consumed = length

    if (length == SYMBOL_NONE) {
        kind = TOKEN_UNEXPECTED
        consumed = SYMBOL_SINGLE
    }

    for (Int step = 0; step < consumed; step++) {
        advance(source, cursor)
    }

    emit(tokens, kind, start, consumed, line, column)
}

static method scanToken(String source, List<Int> cursor, List<Int> tokens) {
    Int current = peek(source, cursor, AHEAD_CURRENT)

    if (isIdentifierStart(current)) {
        lexIdentifier(source, cursor, tokens)
        return
    }

    if (isDigit(current)) {
        lexNumber(source, cursor, tokens)
        return
    }

    if (current == BYTE_QUOTE) {
        lexString(source, cursor, tokens)
        return
    }

    lexSymbol(source, cursor, tokens)
}

static method tokenize(String source, List<Int> cursor, List<Int> tokens) {
    while (peek(source, cursor, AHEAD_CURRENT) != NO_BYTE) {
        if (skipTrivia(source, cursor, tokens)) {
            continue
        }

        scanToken(source, cursor, tokens)
    }

    emit(tokens, TOKEN_EOF, cursor[CURSOR_POSITION], 0, cursor[CURSOR_LINE], columnAt(cursor))
}

static method<List<Int>> lexSource(String source) {
    List<Int> cursor = [FIRST_POSITION, FIRST_LINE, FIRST_POSITION]
    List<Int> tokens = []
    tokenize(source, cursor, tokens)
    return tokens
}

static method<Int> tokenField(List<Int> tokens, Int index, Int field) {
    return tokens[index * TOKEN_STRIDE + field]
}

static method<Int> expectTokens(String source, List<Int> expected) {
    List<Int> tokens = lexSource(source)
    Int count = expected.size() / EXPECTED_STRIDE

    if (tokens.size() != count * TOKEN_STRIDE) {
        return CASE_FAILED
    }

    for (Int index = 0; index < count; index++) {
        Int kind = expected[index * EXPECTED_STRIDE + EXPECTED_KIND]
        Int length = expected[index * EXPECTED_STRIDE + EXPECTED_LENGTH]

        if (tokenField(tokens, index, TOKEN_KIND) != kind || tokenField(tokens, index, TOKEN_LENGTH) != length) {
            return CASE_FAILED
        }
    }

    return CASE_PASSED
}

static method<Int> expectPosition(String source, Int index, Int line, Int column) {
    List<Int> tokens = lexSource(source)

    if (tokenField(tokens, index, TOKEN_LINE) != line || tokenField(tokens, index, TOKEN_COLUMN) != column) {
        return CASE_FAILED
    }

    return CASE_PASSED
}

// Returns the number of failed cases, so 0 means every case passed.
static method<Int> main {
    Int failed = 0
    failed = failed + expectTokens("", [TOKEN_EOF, 0])
    failed = failed + expectTokens("foo bar", [TOKEN_IDENTIFIER, 3, TOKEN_IDENTIFIER, 3, TOKEN_EOF, 0])
    failed = failed + expectTokens("if x1 == 42", [TOKEN_KEYWORD, 2, TOKEN_IDENTIFIER, 2, TOKEN_SYMBOL, 2, TOKEN_NUMBER, 2, TOKEN_EOF, 0])
    failed = failed + expectTokens("1.5e3 1..x", [TOKEN_FLOAT, 5, TOKEN_NUMBER, 1, TOKEN_SYMBOL, 2, TOKEN_IDENTIFIER, 1, TOKEN_EOF, 0])
    failed = failed + expectTokens("a // c\n/* b */ b", [TOKEN_IDENTIFIER, 1, TOKEN_IDENTIFIER, 1, TOKEN_EOF, 0])
    failed = failed + expectPosition("a // c\n/* b */ b", 1, 2, 9)
    failed = failed + expectPosition("a\nb", 1, 2, 1)
    failed = failed + expectTokens("\"a\\nb\"", [TOKEN_STRING, 6, TOKEN_EOF, 0])
    failed = failed + expectTokens("\"v" + "$" + "{x + 1}\"", [TOKEN_STRING, 11, TOKEN_EOF, 0])
    failed = failed + expectTokens("\"v" + "$" + "{f(\"}\")}\"", [TOKEN_STRING, 12, TOKEN_EOF, 0])
    failed = failed + expectTokens("\"abc", [TOKEN_UNTERMINATED_STRING, 4, TOKEN_EOF, 0])
    failed = failed + expectTokens("#", [TOKEN_UNEXPECTED, 1, TOKEN_EOF, 0])
    failed = failed + expectTokens("/* x", [TOKEN_UNTERMINATED_COMMENT, 4, TOKEN_EOF, 0])
    failed = failed + expectTokens("x ... y", [TOKEN_IDENTIFIER, 1, TOKEN_SYMBOL, 3, TOKEN_IDENTIFIER, 1, TOKEN_EOF, 0])
    failed = failed + expectTokens("a<=b", [TOKEN_IDENTIFIER, 1, TOKEN_SYMBOL, 2, TOKEN_IDENTIFIER, 1, TOKEN_EOF, 0])
    failed = failed + expectTokens("iff true", [TOKEN_IDENTIFIER, 3, TOKEN_KEYWORD, 4, TOKEN_EOF, 0])
    failed = failed + expectTokens("_a1", [TOKEN_IDENTIFIER, 3, TOKEN_EOF, 0])
    return failed
}
