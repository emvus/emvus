package ring1.lowering

// One operation as a line of canonical text. Every attribute is written, in the order the grammar fixes.
static method<String> operationText(String source, List<Int> ir, Int record, Int number) {
    Int code = ir[record + OPERATION_CODE]
    Int result = ir[record + OPERATION_RESULT]
    Int type = ir[record + OPERATION_TYPE]

    if (result == NO_VALUE) {
        type = 0
    }

    String text = "    op id=" + intText(number) + " opcode=\"" + opcodeText(code) + "\" span=" + "1" + " result=" + intText(result) + " type=" + intText(type)
    text = text + " ownership=\"" + ownershipText(ir[record + OPERATION_OWNERSHIP]) + "\" ref=" + intText(ir[record + OPERATION_REFERENCE]) + " scope=" + intText(ir[record + OPERATION_SCOPE]) + " overflow=\"" + overflowText(code) + "\" predicate=\"" + predicateText(ir[record + OPERATION_PREDICATE]) + "\" fpmode=\"" + floatModeText(code) + "\" effect=" + intText(effectOf(code))
    text = text + " int=" + intText(integerOf(ir, record)) + " bool=" + boolText(ir[record + OPERATION_BOOL]) + " bits=" + intText(bitsOf(ir, record)) + " text=\"" + escapedText(source, ir[record + OPERATION_TEXT_START], ir[record + OPERATION_TEXT_LENGTH]) + "\" operands=" + operandList(ir, record, false) + " modes=" + operandList(ir, record, true) + " targets=" + targetList(ir, record) + " trueargs=" + intText(ir[record + OPERATION_TRUE_ARGUMENTS]) + "\n"
    return text
}

static method<String> boolText(Int value) {
    if (value == 1) {
        return "true"
    }

    return "false"
}

static method<Int> effectOf(Int code) {
    if (code == OP_CALL) {
        return 1
    }

    return 0
}

static method<String> overflowText(Int code) {
    if (code == OP_ADD || code == OP_SUBTRACT || code == OP_MULTIPLY || code == OP_DIVIDE || code == OP_REMAINDER || code == OP_NEGATE) {
        return "trap"
    }

    return ""
}

static method<String> operandList(List<Int> ir, Int record, Bool modes) {
    String text = "["

    for (Int position = 0; position < ir[record + OPERATION_OPERAND_COUNT]; position++) {
        if (position > 0) {
            text = text + ","
        }

        if (modes) {
            text = text + "\"" + modeText(ir[record + OPERATION_HEADER_SIZE + position * OPERAND_SIZE + 1]) + "\""
        }

        if (!modes) {
            text = text + intText(ir[record + OPERATION_HEADER_SIZE + position * OPERAND_SIZE])
        }
    }

    return text + "]"
}

static method<String> targetList(List<Int> ir, Int record) {
    Int first = ir[record + OPERATION_TARGET]
    Int second = ir[record + OPERATION_SECOND_TARGET]

    if (first == NO_BLOCK) {
        return "[]"
    }

    if (second == NO_BLOCK) {
        return "[" + intText(first) + "]"
    }

    return "[" + intText(first) + "," + intText(second) + "]"
}

static method<String> opcodeText(Int code) {
    if (code == OP_CONST_INT) {
        return "const.int"
    }

    if (code == OP_CONST_BOOL) {
        return "const.bool"
    }

    if (code == OP_CALL) {
        return "call.direct"
    }

    if (code == OP_COMPARE) {
        return "compare"
    }

    if (code == OP_BRANCH) {
        return "branch"
    }

    if (code == OP_CONDITIONAL_BRANCH) {
        return "cond_branch"
    }

    if (code == OP_RETURN) {
        return "return"
    }

    if (code == OP_LIST_CLEAR) {
        return "list.clear"
    }

    if (code >= OP_CONST_FLOAT) {
        return floatOpcodeText(code)
    }

    if (code >= OP_CONST_STRING) {
        return textOpcodeText(code)
    }

    if (code >= OP_LIST_NEW) {
        return listOpcodeText(code)
    }

    return arithmeticText(code)
}

static method<String> arithmeticText(Int code) {
    if (code == OP_ADD) {
        return "int.add"
    }

    if (code == OP_SUBTRACT) {
        return "int.sub"
    }

    if (code == OP_MULTIPLY) {
        return "int.mul"
    }

    if (code == OP_DIVIDE) {
        return "int.div"
    }

    if (code == OP_REMAINDER) {
        return "int.rem"
    }

    return "int.neg"
}

static method<String> predicateText(Int predicate) {
    if (predicate == PREDICATE_LESS) {
        return "lt"
    }

    if (predicate == PREDICATE_LESS_EQUAL) {
        return "le"
    }

    if (predicate == PREDICATE_GREATER) {
        return "gt"
    }

    if (predicate == PREDICATE_GREATER_EQUAL) {
        return "ge"
    }

    if (predicate == PREDICATE_EQUAL) {
        return "eq"
    }

    if (predicate == PREDICATE_NOT_EQUAL) {
        return "ne"
    }

    return orderedPredicateText(predicate)
}

static method<String> orderedPredicateText(Int predicate) {
    if (predicate == PREDICATE_ORDERED_LESS) {
        return "olt"
    }

    if (predicate == PREDICATE_ORDERED_LESS_EQUAL) {
        return "ole"
    }

    if (predicate == PREDICATE_ORDERED_GREATER) {
        return "ogt"
    }

    if (predicate == PREDICATE_ORDERED_GREATER_EQUAL) {
        return "oge"
    }

    if (predicate == PREDICATE_ORDERED_EQUAL) {
        return "oeq"
    }

    if (predicate == PREDICATE_UNORDERED_NOT_EQUAL) {
        return "une"
    }

    return ""
}

static method<String> ownershipText(Int ownership) {
    if (ownership == 1) {
        return "owned"
    }

    return ""
}

static method<String> modeText(Int mode) {
    if (mode == MODE_BORROW_READ) {
        return "borrow_read"
    }

    if (mode == MODE_BORROW_WRITE) {
        return "borrow_write"
    }

    if (mode == MODE_OWNED) {
        return "owned"
    }

    return "value"
}

static method<String> listOpcodeText(Int code) {
    if (code == OP_LIST_NEW) {
        return "list.new"
    }

    if (code == OP_LIST_PUSH) {
        return "list.push"
    }

    if (code == OP_LIST_GET) {
        return "list.get"
    }

    if (code == OP_LIST_SET) {
        return "list.set"
    }

    if (code == OP_LIST_LENGTH) {
        return "list.length"
    }

    if (code == OP_SCOPE_BEGIN) {
        return "scope.begin"
    }

    return "scope.end"
}

static method<String> textOpcodeText(Int code) {
    if (code == OP_CONST_STRING) {
        return "const.string"
    }

    if (code == OP_TEXT_FROM_STR) {
        return "text.from_str"
    }

    if (code == OP_TEXT_CONCAT) {
        return "text.concat"
    }

    if (code == OP_TEXT_SLICE) {
        return "text.slice"
    }

    if (code == OP_TEXT_EQUAL) {
        return "text.equal"
    }

    return "byte.to_int"
}

final var BACKSLASH_BYTE = 92
final var QUOTE_BYTE = 34
final var HEX_BASE = 16
final var NEWLINE_LETTER = 110
final var TAB_LETTER = 116
final var RETURN_LETTER = 114
final var PRINTABLE_FIRST = 32
final var PRINTABLE_END = 127

// The content of a string literal in canonical text: escapes of the source are decoded, then every byte
// that is not printable ASCII (and the quote and backslash) is written as an escape again.
static method<String> escapedText(String source, Int start, Int length) {
    String text = ""
    Int index = 0

    if (start == TEXT_LINE_FEED) {
        return "\\n"
    }

    while (index < length) {
        Int position = start + index
        Int byte = source.byteAt(position)

        if (byte == BACKSLASH_BYTE && index + 1 < length) {
            index = index + 1
            byte = decodedEscape(source.byteAt(start + index))
            position = start + index
        }

        text = text + escapedByte(source, position, byte)
        index = index + 1
    }

    return text
}

static method<Int> decodedEscape(Int letter) {
    if (letter == NEWLINE_LETTER) {
        return 10
    }

    if (letter == TAB_LETTER) {
        return 9
    }

    if (letter == RETURN_LETTER) {
        return 13
    }

    return letter
}

// `position` is where the byte stands in the source, which is how a printable byte becomes a string.
static method<String> escapedByte(String source, Int position, Int byte) {
    if (byte == BACKSLASH_BYTE) {
        return "\\\\"
    }

    if (byte == QUOTE_BYTE) {
        return "\\\""
    }

    if (byte >= PRINTABLE_FIRST && byte < PRINTABLE_END && source.byteAt(position) == byte) {
        return source.substring(position, position + 1)
    }

    String digits = "0123456789abcdef"
    return "\\x" + digits.substring(byte / HEX_BASE, byte / HEX_BASE + 1) + digits.substring(byte % HEX_BASE, byte % HEX_BASE + 1)
}

// The int and bits attributes: a float constant keeps its bit pattern in the int field.
static method<Int> integerOf(List<Int> ir, Int record) {
    if (ir[record + OPERATION_CODE] == OP_CONST_FLOAT) {
        return 0
    }

    return ir[record + OPERATION_INT]
}

static method<Int> bitsOf(List<Int> ir, Int record) {
    if (ir[record + OPERATION_CODE] == OP_CONST_FLOAT) {
        return ir[record + OPERATION_INT]
    }

    return 0
}

static method<String> floatModeText(Int code) {
    if (code >= OP_FLOAT_ADD && code <= OP_FLOAT_DIVIDE) {
        return "rne"
    }

    return ""
}

static method<String> floatOpcodeText(Int code) {
    if (code == OP_CONST_FLOAT) {
        return "const.float"
    }

    if (code == OP_FLOAT_ADD) {
        return "float.add"
    }

    if (code == OP_FLOAT_SUBTRACT) {
        return "float.sub"
    }

    if (code == OP_FLOAT_MULTIPLY) {
        return "float.mul"
    }

    return "float.div"
}
