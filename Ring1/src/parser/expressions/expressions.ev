package ring1.parser

final var LEVEL_LOWEST = 1
final var QUOTE_LENGTH = 1
final var LEVEL_NONE = 0
final var LEVEL_OR = 1
final var LEVEL_AND = 2
final var LEVEL_EQUALITY = 3
final var LEVEL_COMPARISON = 4
final var LEVEL_ADDITIVE = 5
final var LEVEL_MULTIPLICATIVE = 6

// An expression, optionally the target of an assignment (right associative).
static method<Int> parseExpression(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    Int target = parseBinary(source, tokens, state, nodes, LEVEL_LOWEST)

    if (atTernaryQuestion(source, tokens, state)) {
        target = parseTernary(source, tokens, state, nodes, target)
    }

    if (!atAssignOperator(source, tokens, state)) {
        return target
    }

    Int assign = addNodeAtToken(nodes, NODE_ASSIGN, tokens, state)
    advanceToken(tokens, state)
    appendChild(nodes, assign, target)
    appendChild(nodes, assign, parseExpression(source, tokens, state, nodes))
    return assign
}

// `condition ? a : b`. A `?` that ends the line, or is followed by a closing bracket or separator, is
// error propagation instead.
static method<Bool> atTernaryQuestion(String source, List<Int> tokens, List<Int> state) {
    if (!atSymbol(source, tokens, state, "?") || !nextOnSameLine(tokens, state)) {
        return false
    }

    return !symbolAhead(source, tokens, state, AHEAD_NEXT, ")") && !symbolAhead(source, tokens, state, AHEAD_NEXT, "]") && !symbolAhead(source, tokens, state, AHEAD_NEXT, "}") && !symbolAhead(source, tokens, state, AHEAD_NEXT, ",") && !symbolAhead(source, tokens, state, AHEAD_NEXT, ";") && !symbolAhead(source, tokens, state, AHEAD_NEXT, ":")
}

static method<Int> parseTernary(String source, List<Int> tokens, List<Int> state, List<Int> nodes, Int condition) {
    Int ternary = addEmptyNode(nodes, NODE_TERNARY, tokens, state)
    advanceToken(tokens, state)
    appendChild(nodes, ternary, condition)
    appendChild(nodes, ternary, parseExpression(source, tokens, state, nodes))
    expectSymbol(source, tokens, state, ":")
    appendChild(nodes, ternary, parseExpression(source, tokens, state, nodes))
    return ternary
}

static method<Bool> atAssignOperator(String source, List<Int> tokens, List<Int> state) {
    return atSymbol(source, tokens, state, "=") || atSymbol(source, tokens, state, "+=") || atSymbol(source, tokens, state, "-=") || atSymbol(source, tokens, state, "*=") || atSymbol(source, tokens, state, "/=") || atSymbol(source, tokens, state, "%=")
}

static method<Int> binaryLevel(String source, List<Int> tokens, List<Int> state) {
    if (!atKind(tokens, state, TOKEN_SYMBOL) || !onPreviousLine(tokens, state)) {
        return LEVEL_NONE
    }

    String text = tokenText(source, tokens, tokenIndexAhead(tokens, state, AHEAD_CURRENT))

    if (text == "||") {
        return LEVEL_OR
    }

    if (text == "&&") {
        return LEVEL_AND
    }

    if (text == "==" || text == "!=") {
        return LEVEL_EQUALITY
    }

    if (text == "<" || text == ">" || text == "<=" || text == ">=") {
        return LEVEL_COMPARISON
    }

    if (text == "+" || text == "-") {
        return LEVEL_ADDITIVE
    }

    if (text == "*" || text == "/" || text == "%") {
        return LEVEL_MULTIPLICATIVE
    }

    return LEVEL_NONE
}

// Precedence climbing: operators of at least `minimum` bind here, tighter ones in the recursion.
static method<Int> parseBinary(String source, List<Int> tokens, List<Int> state, List<Int> nodes, Int minimum) {
    Int left = parseUnary(source, tokens, state, nodes)

    while (true) {
        if (minimum <= LEVEL_COMPARISON && atTypeTest(source, tokens, state)) {
            left = parseTypeTest(source, tokens, state, nodes, left)
            continue
        }

        Int level = binaryLevel(source, tokens, state)

        if (level == LEVEL_NONE || level < minimum) {
            break
        }

        Int operator = addNodeAtToken(nodes, NODE_BINARY, tokens, state)
        advanceToken(tokens, state)
        Int right = parseBinary(source, tokens, state, nodes, level + 1)
        appendChild(nodes, operator, left)
        appendChild(nodes, operator, right)
        left = operator
    }

    return left
}

static method<Bool> atTypeTest(String source, List<Int> tokens, List<Int> state) {
    return onPreviousLine(tokens, state) && (atKeyword(source, tokens, state, "is") || atKeyword(source, tokens, state, "as"))
}

// `value is Type` and `value as Type`.
static method<Int> parseTypeTest(String source, List<Int> tokens, List<Int> state, List<Int> nodes, Int value) {
    Int kind = NODE_AS

    if (atKeyword(source, tokens, state, "is")) {
        kind = NODE_IS
    }

    Int test = addEmptyNode(nodes, kind, tokens, state)
    advanceToken(tokens, state)
    appendChild(nodes, test, value)
    appendChild(nodes, test, parseType(source, tokens, state, nodes))
    return test
}

static method<Int> parseUnary(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    if (!atSymbol(source, tokens, state, "-") && !atSymbol(source, tokens, state, "!")) {
        return parsePostfix(source, tokens, state, nodes)
    }

    Int unary = addNodeAtToken(nodes, NODE_UNARY, tokens, state)
    advanceToken(tokens, state)
    appendChild(nodes, unary, parseUnary(source, tokens, state, nodes))
    return unary
}

// Calls, indexing, member access and `++` / `--`, applied left to right.
static method<Int> parsePostfix(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    Int target = parsePrimary(source, tokens, state, nodes)

    while (true) {
        Bool sameLine = onPreviousLine(tokens, state)

        if (sameLine && atSymbol(source, tokens, state, "(")) {
            target = parseCall(source, tokens, state, nodes, target)
            continue
        }

        if (sameLine && atSymbol(source, tokens, state, "[")) {
            target = parseIndex(source, tokens, state, nodes, target)
            continue
        }

        if (atSymbol(source, tokens, state, ".")) {
            target = parseMemberAccess(source, tokens, state, nodes, target)
            continue
        }

        if (sameLine && atSymbol(source, tokens, state, "?") && !atTernaryQuestion(source, tokens, state)) {
            target = parseWrapper(tokens, state, nodes, NODE_PROPAGATE, target)
            continue
        }

        if (sameLine && atSymbol(source, tokens, state, "!")) {
            target = parseWrapper(tokens, state, nodes, NODE_UNWRAP, target)
            continue
        }

        if (state[STATE_CASCADE] == CASCADE_OPEN && atSymbol(source, tokens, state, "..")) {
            target = parseCascade(source, tokens, state, nodes, target)
            continue
        }

        if (atSymbol(source, tokens, state, "++") || atSymbol(source, tokens, state, "--")) {
            Int postfix = addNodeAtToken(nodes, NODE_POSTFIX, tokens, state)
            advanceToken(tokens, state)
            appendChild(nodes, postfix, target)
            target = postfix
            continue
        }

        break
    }

    return target
}

// `value?` and `value!`: one child, no text.
static method<Int> parseWrapper(List<Int> tokens, List<Int> state, List<Int> nodes, Int kind, Int value) {
    Int wrapper = addEmptyNode(nodes, kind, tokens, state)
    advanceToken(tokens, state)
    appendChild(nodes, wrapper, value)
    return wrapper
}

// `receiver ..a() ..b = 1`: every section runs on the receiver. A section ends at the next `..`.
static method<Int> parseCascade(String source, List<Int> tokens, List<Int> state, List<Int> nodes, Int receiver) {
    Int cascade = addEmptyNode(nodes, NODE_CASCADE, tokens, state)
    appendChild(nodes, cascade, receiver)
    state[STATE_CASCADE] = CASCADE_CLOSED

    while (atSymbol(source, tokens, state, "..")) {
        Int section = addEmptyNode(nodes, NODE_CASCADE_SECTION, tokens, state)
        advanceToken(tokens, state)
        appendChild(nodes, section, parseExpression(source, tokens, state, nodes))
        appendChild(nodes, cascade, section)
    }

    state[STATE_CASCADE] = CASCADE_OPEN
    return cascade
}

static method<Int> parseCall(String source, List<Int> tokens, List<Int> state, List<Int> nodes, Int callee) {
    Int call = addEmptyNode(nodes, NODE_CALL, tokens, state)
    advanceToken(tokens, state)
    appendChild(nodes, call, callee)
    parseElements(source, tokens, state, nodes, call, ")")
    return call
}

static method<Int> parseIndex(String source, List<Int> tokens, List<Int> state, List<Int> nodes, Int receiver) {
    Int index = addEmptyNode(nodes, NODE_INDEX, tokens, state)
    advanceToken(tokens, state)
    appendChild(nodes, index, receiver)
    appendChild(nodes, index, parseExpression(source, tokens, state, nodes))
    expectSymbol(source, tokens, state, "]")
    return index
}

static method<Int> parseMemberAccess(String source, List<Int> tokens, List<Int> state, List<Int> nodes, Int receiver) {
    advanceToken(tokens, state)

    if (!atKind(tokens, state, TOKEN_IDENTIFIER)) {
        recordError(state)
        return receiver
    }

    Int member = addNodeAtToken(nodes, NODE_MEMBER, tokens, state)
    advanceToken(tokens, state)
    appendChild(nodes, member, receiver)
    return member
}

// `{ key: value, ... }`
static method<Int> parseDictLiteral(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    Int dictionary = addEmptyNode(nodes, NODE_DICT_LITERAL, tokens, state)
    advanceToken(tokens, state)

    while (!atSymbol(source, tokens, state, "}") && !atEnd(tokens, state)) {
        Int before = state[STATE_TOKEN]
        Int entry = addEmptyNode(nodes, NODE_DICT_ENTRY, tokens, state)
        appendChild(nodes, entry, parseExpression(source, tokens, state, nodes))
        expectSymbol(source, tokens, state, ":")
        appendChild(nodes, entry, parseExpression(source, tokens, state, nodes))
        appendChild(nodes, dictionary, entry)
        ensureProgress(tokens, state, before)

        if (atSymbol(source, tokens, state, ",")) {
            advanceToken(tokens, state)
        }
    }

    expectSymbol(source, tokens, state, "}")
    return dictionary
}

// `fiber { ... }`, `virtual { ... }`, `thread { ... }`: the node text is the keyword.
static method<Int> parseTask(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    Int task = addNodeAtToken(nodes, NODE_TASK, tokens, state)
    advanceToken(tokens, state)
    appendChild(nodes, task, parseBlock(source, tokens, state, nodes))
    return task
}

// Comma separated expressions up to `closing`, which is consumed. Cascades work again inside.
static method parseElements(String source, List<Int> tokens, List<Int> state, List<Int> nodes, Int parent, String closing) {
    Int outer = state[STATE_CASCADE]
    state[STATE_CASCADE] = CASCADE_OPEN

    while (!atSymbol(source, tokens, state, closing) && !atEnd(tokens, state)) {
        Int before = state[STATE_TOKEN]
        appendChild(nodes, parent, parseExpression(source, tokens, state, nodes))
        ensureProgress(tokens, state, before)

        if (!atSymbol(source, tokens, state, ",")) {
            break
        }

        advanceToken(tokens, state)
    }

    expectSymbol(source, tokens, state, closing)
    state[STATE_CASCADE] = outer
}

static method<Int> parsePrimary(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    if (atKind(tokens, state, TOKEN_NUMBER)) {
        return parseLeaf(tokens, state, nodes, NODE_INT_LITERAL)
    }

    if (atKind(tokens, state, TOKEN_FLOAT)) {
        return parseLeaf(tokens, state, nodes, NODE_FLOAT_LITERAL)
    }

    if (atKind(tokens, state, TOKEN_IDENTIFIER)) {
        return parseLeaf(tokens, state, nodes, NODE_NAME)
    }

    if (atKind(tokens, state, TOKEN_STRING)) {
        return parseString(tokens, state, nodes)
    }

    if (atKeyword(source, tokens, state, "true") || atKeyword(source, tokens, state, "false")) {
        return parseLeaf(tokens, state, nodes, NODE_BOOL_LITERAL)
    }

    if (atSymbol(source, tokens, state, "(") && atLambda(source, tokens, state)) {
        return parseLambda(source, tokens, state, nodes)
    }

    if (atSymbol(source, tokens, state, "(")) {
        return parseParenthesized(source, tokens, state, nodes)
    }

    if (atKeyword(source, tokens, state, "this") || atKeyword(source, tokens, state, "super") || nameKeywordAhead(source, tokens, state, AHEAD_CURRENT)) {
        return parseLeaf(tokens, state, nodes, NODE_NAME)
    }

    if (atSymbol(source, tokens, state, "{")) {
        return parseDictLiteral(source, tokens, state, nodes)
    }

    if (atKeyword(source, tokens, state, "fiber") || atKeyword(source, tokens, state, "virtual") || atKeyword(source, tokens, state, "thread")) {
        return parseTask(source, tokens, state, nodes)
    }

    if (atKeyword(source, tokens, state, "null")) {
        return withoutText(nodes, parseLeaf(tokens, state, nodes, NODE_NULL_LITERAL))
    }

    if (atKeyword(source, tokens, state, "switch")) {
        return parseSwitch(source, tokens, state, nodes, true)
    }

    if (atSymbol(source, tokens, state, "[")) {
        return parseListLiteral(source, tokens, state, nodes)
    }

    return parseError(tokens, state, nodes)
}

static method<Int> parseLeaf(List<Int> tokens, List<Int> state, List<Int> nodes, Int kind) {
    Int leaf = addNodeAtToken(nodes, kind, tokens, state)
    advanceToken(tokens, state)
    return leaf
}

// The node text is the content between the quotes, still escaped.
static method<Int> parseString(List<Int> tokens, List<Int> state, List<Int> nodes) {
    Int index = tokenIndexAhead(tokens, state, AHEAD_CURRENT)
    Int start = tokenValue(tokens, index, TOKEN_START) + QUOTE_LENGTH
    Int length = tokenValue(tokens, index, TOKEN_LENGTH) - QUOTE_LENGTH - QUOTE_LENGTH
    Int string = addNode(nodes, NODE_STRING, start, length, tokenValue(tokens, index, TOKEN_LINE), tokenValue(tokens, index, TOKEN_COLUMN))
    advanceToken(tokens, state)
    return string
}

static method<Int> parseParenthesized(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    advanceToken(tokens, state)
    Int outer = state[STATE_CASCADE]
    state[STATE_CASCADE] = CASCADE_OPEN
    Int inner = parseExpression(source, tokens, state, nodes)
    state[STATE_CASCADE] = outer
    expectSymbol(source, tokens, state, ")")
    return inner
}

static method<Int> parseListLiteral(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    Int list = addEmptyNode(nodes, NODE_LIST_LITERAL, tokens, state)
    advanceToken(tokens, state)
    parseElements(source, tokens, state, nodes, list, "]")
    return list
}

// An unexpected token becomes an error node and is skipped, so parsing always makes progress.
static method<Int> parseError(List<Int> tokens, List<Int> state, List<Int> nodes) {
    Int error = addNodeAtToken(nodes, NODE_ERROR, tokens, state)
    recordError(state)
    advanceToken(tokens, state)
    return error
}
