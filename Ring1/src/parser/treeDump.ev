package ring1.parser

final var INDENT_WIDTH = 2

// Kind names in the order of the NODE_* constants, each followed by a separator.
static method<String> kindNames() {
    return "file|package|variable|method|modifiers|modifier|type|return-type|params|param|block|local|init|condition|update|if|while|for|return|break|continue|expr-stmt|assign|binary|unary|postfix|call|member|index|name|int-literal|float-literal|string|bool-literal|list-literal|error|enum|body|enum-entry|record|data-class|exception|based|implements|interface|class|field|property|accessors|accessor|constructor|super-call|where|typeparam|foreach|fail|success|ternary|propagate|unwrap|is|as|lambda|cascade|cascade-section|destructure|binding|wildcard|tuple-type|null-literal|var|switch|case|patterns|pattern|pattern-literal|pattern-success|pattern-error|pattern-value|pattern-name|dict-literal|dict-entry|task|interpolation|use|use-item|alias|annotation|placeholder|generic-ref|"
}

static method<String> kindName(Int kind) {
    String names = kindNames()
    Int start = 0
    Int skipped = 0

    while (skipped < kind) {
        if (names.byteAt(start) == BYTE_PIPE) {
            skipped = skipped + 1
        }

        start = start + 1
    }

    Int end = start

    while (names.byteAt(end) != BYTE_PIPE) {
        end = end + 1
    }

    return names.substring(start, end)
}

// One line per node: indentation, kind and, when present, text. Same shape as Ring0's `dump`.
static method<String> dumpNode(String source, List<Int> nodes, Int id, Int depth) {
    String text = ""

    for (Int level = 0; level < depth * INDENT_WIDTH; level++) {
        text = text + " "
    }

    text = text + kindName(nodeField(nodes, id, NODE_KIND))
    Int length = nodeField(nodes, id, NODE_TEXT_LENGTH)

    if (length > 0) {
        Int start = nodeField(nodes, id, NODE_TEXT_START)
        text = text + " " + nodeText(source, nodes, id, start, length) + extraText(source, nodes, id)
    }

    text = text + "\n"
    Int child = nodeField(nodes, id, NODE_FIRST_CHILD)

    while (child != NO_NODE) {
        text = text + dumpNode(source, nodes, child, depth + 1)
        child = nodeField(nodes, child, NODE_NEXT_SIBLING)
    }

    return text
}

// String nodes keep the raw content between the quotes; the dump resolves the escapes like Ring0 does.
static method<String> nodeText(String source, List<Int> nodes, Int id, Int start, Int length) {
    String raw = source.substring(start, start + length)

    if (nodeField(nodes, id, NODE_KIND) != NODE_STRING) {
        return raw
    }

    return unescapeText(raw)
}

static method<String> unescapeText(String raw) {
    String text = ""
    Int index = 0

    while (index < raw.length()) {
        if (raw.byteAt(index) == BYTE_BACKSLASH && index + 1 < raw.length()) {
            text = text + escapedCharacter(raw.byteAt(index + 1), raw.substring(index + 1, index + 2))
            index = index + 2
            continue
        }

        text = text + raw.substring(index, index + 1)
        index = index + 1
    }

    return text
}

static method<String> escapedCharacter(Int code, String character) {
    if (code == BYTE_LOWER_N) {
        return "\n"
    }

    if (code == BYTE_LOWER_R) {
        return "\r"
    }

    if (code == BYTE_LOWER_T) {
        return "\t"
    }

    return character
}

// The second span of a node whose text is not contiguous in the source.
static method<String> extraText(String source, List<Int> nodes, Int id) {
    Int start = nodeField(nodes, id, NODE_EXTRA_START)
    return source.substring(start, start + nodeField(nodes, id, NODE_EXTRA_LENGTH))
}
