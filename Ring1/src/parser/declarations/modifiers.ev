package ring1.parser

// Modifiers and annotations.

// Annotations and modifiers are parsed into one node; `appendModifiers` splits them again.
static method<Int> parseModifiers(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    Int modifiers = addEmptyNode(nodes, NODE_MODIFIERS, tokens, state)

    while (atSymbol(source, tokens, state, "@") || atModifier(source, tokens, state)) {
        if (atSymbol(source, tokens, state, "@")) {
            appendChild(nodes, modifiers, parseAnnotation(source, tokens, state, nodes))
        }

        if (!atSymbol(source, tokens, state, "@") && atModifier(source, tokens, state)) {
            appendChild(nodes, modifiers, parseLeaf(tokens, state, nodes, NODE_MODIFIER))
        }
    }

    return modifiers
}

// `@Name` or `@Name(arguments)`.
static method<Int> parseAnnotation(String source, List<Int> tokens, List<Int> state, List<Int> nodes) {
    advanceToken(tokens, state)
    Int annotation = addNodeAtToken(nodes, NODE_ANNOTATION, tokens, state)
    expectIdentifier(tokens, state)

    if (atSymbol(source, tokens, state, "(") && onPreviousLine(tokens, state)) {
        advanceToken(tokens, state)
        parseElements(source, tokens, state, nodes, annotation, ")")
    }

    return annotation
}

// Annotations come first among a declaration's children, the modifiers node after them.
static method appendModifiers(List<Int> nodes, Int declaration, Int modifiers) {
    Int child = nodeField(nodes, modifiers, NODE_FIRST_CHILD)
    setNodeField(nodes, modifiers, NODE_FIRST_CHILD, NO_NODE)
    setNodeField(nodes, modifiers, NODE_LAST_CHILD, NO_NODE)

    while (child != NO_NODE) {
        Int next = nodeField(nodes, child, NODE_NEXT_SIBLING)
        setNodeField(nodes, child, NODE_NEXT_SIBLING, NO_NODE)

        if (nodeField(nodes, child, NODE_KIND) == NODE_ANNOTATION) {
            appendChild(nodes, declaration, child)
        }

        if (nodeField(nodes, child, NODE_KIND) != NODE_ANNOTATION) {
            appendChild(nodes, modifiers, child)
        }

        child = next
    }

    appendChild(nodes, declaration, modifiers)
}

static method<Bool> atModifier(String source, List<Int> tokens, List<Int> state) {
    return atKeyword(source, tokens, state, "final") || atKeyword(source, tokens, state, "static") || atKeyword(source, tokens, state, "abstract") || atKeyword(source, tokens, state, "override") || atKeyword(source, tokens, state, "private") || atKeyword(source, tokens, state, "protected") || atKeyword(source, tokens, state, "public") || atKeyword(source, tokens, state, "scoped")
}
