package ring1.binder

// Expressions made of several parts: list literals, ternaries, type tests, Result flow and tuples.
// The elements share the type of the first one; an empty list takes the type the context expects.
static method<Int> bindListLiteral(String source, List<Int> nodes, List<Int> types, List<Int> symbols, List<Int> annotations, List<Int> state, Int node, Int expected) {
    Int first = nodeField(nodes, node, NODE_FIRST_CHILD)
    Int type = expected

    if (first != NO_NODE && typeField(types, expected, TYPE_KIND) == KIND_TUPLE) {
        bindListElements(source, nodes, types, symbols, annotations, state, first)
    }

    if (first != NO_NODE && typeField(types, expected, TYPE_KIND) != KIND_TUPLE) {
        type = listType(types, bindListElements(source, nodes, types, symbols, annotations, state, first))
    }

    annotate(annotations, node, type, REFERENCE_LITERAL, 0, 0, OWNER_NONE, 0)
    return type
}

// Binds all elements and returns the type of the first.
static method<Int> bindListElements(String source, List<Int> nodes, List<Int> types, List<Int> symbols, List<Int> annotations, List<Int> state, Int first) {
    Int element = bindExpression(source, nodes, types, symbols, annotations, state, first, TYPE_UNKNOWN)
    Int next = nodeField(nodes, first, NODE_NEXT_SIBLING)

    while (next != NO_NODE) {
        bindExpression(source, nodes, types, symbols, annotations, state, next, element)
        next = nodeField(nodes, next, NODE_NEXT_SIBLING)
    }

    return element
}

// `condition ? then : otherwise` has the type of the branch that is not `null`.
static method<Int> bindTernary(String source, List<Int> nodes, List<Int> types, List<Int> symbols, List<Int> annotations, List<Int> state, Int node, Int expected) {
    Int condition = nodeField(nodes, node, NODE_FIRST_CHILD)
    Int whenTrue = nodeField(nodes, condition, NODE_NEXT_SIBLING)
    Int whenFalse = nodeField(nodes, whenTrue, NODE_NEXT_SIBLING)
    bindExpression(source, nodes, types, symbols, annotations, state, condition, TYPE_BOOLEAN)
    Int type = bindExpression(source, nodes, types, symbols, annotations, state, whenTrue, expected)
    Int other = bindExpression(source, nodes, types, symbols, annotations, state, whenFalse, type)

    if (type == TYPE_NULL) {
        type = other
    }

    annotateType(annotations, node, type)
    return type
}

// `value is Type` is a Boolean and `value as Type` has that type; the type name is not an expression.
static method<Int> bindTypeTest(String source, List<Int> nodes, List<Int> types, List<Int> symbols, List<Int> annotations, List<Int> state, Int node, Int kind) {
    Int value = nodeField(nodes, node, NODE_FIRST_CHILD)
    bindExpression(source, nodes, types, symbols, annotations, state, value, TYPE_UNKNOWN)
    Int type = TYPE_BOOLEAN

    if (kind == NODE_AS) {
        type = typeOfNode(source, nodes, types, nodeField(nodes, value, NODE_NEXT_SIBLING))
    }

    annotateType(annotations, node, type)
    return type
}

// `result?` and `result!` have the value type of the Result they are applied to.
static method<Int> bindResultFlow(String source, List<Int> nodes, List<Int> types, List<Int> symbols, List<Int> annotations, List<Int> state, Int node) {
    Int result = bindExpression(source, nodes, types, symbols, annotations, state, nodeField(nodes, node, NODE_FIRST_CHILD), TYPE_UNKNOWN)
    Int type = TYPE_UNKNOWN

    if (isResult(source, types, result)) {
        type = typeArgument(types, result, 0)
    }

    annotateType(annotations, node, type)
    return type
}

// `tuple[0]`: the type at the position the literal index names.
static method<Int> tupleElement(String source, List<Int> nodes, List<Int> types, Int node, Int tuple) {
    Int index = nodeField(nodes, nodeField(nodes, node, NODE_FIRST_CHILD), NODE_NEXT_SIBLING)
    Int position = digitValue(source, nodeField(nodes, index, NODE_TEXT_START), nodeField(nodes, index, NODE_TEXT_LENGTH))

    if (position < 0) {
        return TYPE_UNKNOWN
    }

    return typeOrUnknown(typeArgument(types, tuple, position))
}
