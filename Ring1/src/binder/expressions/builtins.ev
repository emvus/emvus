package ring1.binder

// The members of String and List the compiler uses, after Ring0's built-in member table. A member is
// found by name and argument count; an unknown member keeps the unknown type.
static method<Int> ownerOf(String source, List<Int> types, Int receiver) {
    Int kind = typeField(types, receiver, TYPE_KIND)

    if (kind == KIND_STRING) {
        return OWNER_STRING
    }

    if (kind == KIND_LIST) {
        return OWNER_LIST
    }

    if (typeField(types, receiver, TYPE_KIND) == KIND_FIBER) {
        return OWNER_FIBER
    }

    if (isResult(source, types, receiver)) {
        return OWNER_RESULT
    }

    return OWNER_NONE
}

static method<Bool> isResult(String source, List<Int> types, Int type) {
    return typeField(types, type, TYPE_KIND) == KIND_APPLIED && spanIs(source, typeField(types, type, TYPE_NAME_START), typeField(types, type, TYPE_NAME_LENGTH), "Result")
}

// The result type of `receiver.name(arguments)`, TYPE_UNKNOWN when there is no such member.
static method<Int> memberResult(String source, List<Int> types, Int receiver, Int start, Int length, Int argumentCount, Int last) {
    Int owner = ownerOf(source, types, receiver)

    if (owner == OWNER_STRING) {
        return stringMemberResult(source, types, start, length, argumentCount)
    }

    if (owner == OWNER_LIST) {
        return listMemberResult(source, types, receiver, start, length, argumentCount, last)
    }

    if (owner == OWNER_FIBER && isMember(source, start, length, "await", argumentCount, 0)) {
        return typeArgument(types, receiver, 0)
    }

    if (owner == OWNER_RESULT) {
        return resultMemberResult(source, types, receiver, start, length, argumentCount)
    }

    return TYPE_UNKNOWN
}

static method<Int> resultMemberResult(String source, List<Int> types, Int receiver, Int start, Int length, Int argumentCount) {
    if (isMember(source, start, length, "orElse", argumentCount, 1)) {
        return typeArgument(types, receiver, 0)
    }

    if (isMember(source, start, length, "isSuccess", argumentCount, 0) || isMember(source, start, length, "isError", argumentCount, 0)) {
        return TYPE_BOOLEAN
    }

    return TYPE_UNKNOWN
}

// Global functions, after Ring0's built-in table: the ones that print, panic or exit take one argument and return
// nothing, `readFile` and `argument` return a String, `writeFile` and `fileExists` a Boolean, `argumentCount` an Int. TYPE_UNKNOWN when there is none.
static method<Int> builtinFunctionType(String source, Int start, Int length, Int argumentCount) {
    if (argumentCount == 1 && (spanIs(source, start, length, "println") || spanIs(source, start, length, "print") || spanIs(source, start, length, "errprintln") || spanIs(source, start, length, "errprint") || spanIs(source, start, length, "panic") || spanIs(source, start, length, "exit"))) {
        return TYPE_VOID
    }

    if (argumentCount == 1 && spanIs(source, start, length, "fileExists")) {
        return TYPE_BOOLEAN
    }

    if (argumentCount == 0 && spanIs(source, start, length, "argumentCount")) {
        return TYPE_INT
    }

    if (argumentCount == 1 && (spanIs(source, start, length, "readFile") || spanIs(source, start, length, "argument"))) {
        return TYPE_STRING
    }

    if (argumentCount == 2 && spanIs(source, start, length, "writeFile")) {
        return TYPE_BOOLEAN
    }

    return TYPE_UNKNOWN
}

static method<Bool> isMember(String source, Int start, Int length, String name, Int argumentCount, Int expectedCount) {
    return argumentCount == expectedCount && spanIs(source, start, length, name)
}
