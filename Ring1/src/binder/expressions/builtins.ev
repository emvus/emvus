package ring1.binder

// The members of String and List the compiler uses, after Ring0's built-in member table. A member is
// found by name and argument count; an unknown member keeps the unknown type.
static method<Int> ownerOf(List<Int> types, Int receiver) {
    Int kind = typeField(types, receiver, TYPE_KIND)

    if (kind == KIND_STRING) {
        return OWNER_STRING
    }

    if (kind == KIND_LIST) {
        return OWNER_LIST
    }

    return OWNER_NONE
}

// The result type of `receiver.name(arguments)`, TYPE_UNKNOWN when there is no such member.
static method<Int> memberResult(String source, List<Int> types, Int receiver, Int start, Int length, Int argumentCount) {
    Int owner = ownerOf(types, receiver)

    if (owner == OWNER_STRING) {
        return stringMemberResult(source, types, start, length, argumentCount)
    }

    if (owner == OWNER_LIST) {
        return listMemberResult(source, types, receiver, start, length, argumentCount)
    }

    return TYPE_UNKNOWN
}

// Global functions: they take one argument and return nothing.
static method<Bool> isBuiltinFunction(String source, Int start, Int length) {
    return spanIs(source, start, length, "println") || spanIs(source, start, length, "print") || spanIs(source, start, length, "errprintln") || spanIs(source, start, length, "panic")
}

static method<Bool> isMember(String source, Int start, Int length, String name, Int argumentCount, Int expectedCount) {
    return argumentCount == expectedCount && spanIs(source, start, length, name)
}
