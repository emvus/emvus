package ring1.binder

// `receiver.name` on a value of a type of the program reads one of that type's properties or fields.
static method<Int> bindMember(String source, List<Int> nodes, List<Int> types, List<Int> symbols, List<Int> annotations, List<Int> state, Int node) {
    Int receiver = bindExpression(source, nodes, types, symbols, annotations, state, nodeField(nodes, node, NODE_FIRST_CHILD), TYPE_UNKNOWN)
    Int row = NO_SYMBOL

    if (typeField(types, receiver, TYPE_KIND) == KIND_NAMED) {
        row = lookupMember(source, symbols, state, receiver, nodeField(nodes, node, NODE_TEXT_START), nodeField(nodes, node, NODE_TEXT_LENGTH), ROW_PROPERTY, ROW_FIELD, NO_SYMBOL)
    }

    if (typeField(types, receiver, TYPE_KIND) == KIND_TYPE_OBJECT) {
        row = lookupMember(source, symbols, state, typeField(types, receiver, TYPE_ELEMENT), nodeField(nodes, node, NODE_TEXT_START), nodeField(nodes, node, NODE_TEXT_LENGTH), ROW_ENTRY, ROW_ENTRY, NO_SYMBOL)
    }

    if (row == NO_SYMBOL) {
        annotateType(annotations, node, TYPE_UNKNOWN)
        return TYPE_UNKNOWN
    }

    return annotateSymbol(annotations, symbols, node, row)
}
