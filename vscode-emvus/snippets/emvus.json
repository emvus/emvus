{
  "package": { "prefix": "package", "body": ["package ${1:main}", "", "$0"], "description": "Package declaration" },
  "use": { "prefix": "use", "body": "use ${1:std.collections.IList}", "description": "Import" },
  "use alias": { "prefix": "usea", "body": "use ${1:util.playermanager.gamingPlayer} as ${2:Alias}" },
  "use block": { "prefix": "useblock", "body": ["use {", "\t${1:std.collections}.[${2:IList}, ${3:IIterator}],", "\t$0", "}"], "description": "Grouped imports" },
  "class": { "prefix": "class", "body": ["class ${1:Name} {", "\t$0", "}"] },
  "class based": { "prefix": "classb", "body": ["class ${1:Name} based ${2:Base} {", "\t${1}(${3}) : super(${4}) { }", "\t$0", "}"] },
  "class implements": { "prefix": "classi", "body": ["class ${1:Name} implements ${2:Interface} {", "\t$0", "}"] },
  "abstract class": { "prefix": "abstract", "body": ["abstract class ${1:Name} {", "\tabstract method<${2:String}> ${3:name}", "", "\t$0", "}"] },
  "generic class": { "prefix": "classg", "body": ["class ${1:Box} where ${2:T} {", "\t${2} value { get, set }", "", "\t${1}(${2} value) {", "\t\tthis.value = value", "\t}", "\t$0", "}"] },
  "data class": { "prefix": ["data", "dataclass"], "body": "data class ${1:Member}(${2:String name}, ${3:Int age})" },
  "data class body": { "prefix": "databody", "body": ["data class ${1:Employee}(${2:String name}, ${3:Int age}) {", "\tmethod<${4:Boolean}> ${5:isAdult}() {", "\t\treturn ${6:age >= 18}", "\t}", "}"] },
  "record": { "prefix": "record", "body": "record ${1:Point}(${2:Int x}, ${3:Int y})" },
  "interface": { "prefix": "interface", "body": ["interface ${1:IName} {", "\tmethod<${2:String}> ${3:name}", "\t$0", "}"] },
  "enum": { "prefix": "enum", "body": ["enum ${1:Rank} {", "\t${2:MEMBER},", "\t${3:MODERATOR},", "\t${4:ADMIN}", "}"] },
  "exception": { "prefix": "exception", "body": "exception ${1:ReadFileException} based ${2:IOException}" },
  "exception fields": { "prefix": "exceptionf", "body": "exception ${1:ParseException}(${2:String input}, ${3:Int position})" },
  "exception message": { "prefix": "exceptionm", "body": ["exception ${1:RangeException}(${2:Int value}, ${3:Int min}, ${4:Int max}) {", "\tmethod<String> message {", "\t\treturn \"\\${value} liegt nicht zwischen \\${min} und \\${max}\"", "\t}", "}"] },
  "constructor": { "prefix": "ctor", "body": ["${1:Name}(${2:String name}) {", "\tthis.${3:name} = ${3:name}", "}"] },
  "constructor super": { "prefix": "ctors", "body": "${1:Name}(${2:String name}) : super(${2:name}) { }" },
  "property": { "prefix": "prop", "body": "${1:String} ${2:name} { get${3:, set} }" },
  "property null": { "prefix": "propnull", "body": "${1:String} ${2:nickname} { get, set } = null" },
  "field": { "prefix": "field", "body": "private ${1:Int} ${2:visits}" },
  "final var": { "prefix": ["final", "const"], "body": "final var ${1:NAME} = ${2:value}" },
  "var": { "prefix": "var", "body": "var ${1:name} = ${2:value}" },
  "method": { "prefix": ["method", "m"], "body": ["method${1:<${2:Int}>} ${3:name}(${4}) {", "\t$0", "}"] },
  "method void": { "prefix": "methodv", "body": ["method ${1:name}(${2}) {", "\t$0", "}"] },
  "method no parens": { "prefix": "methodn", "body": ["method<${1:Int}> ${2:name} {", "\t$0", "}"] },
  "static method": { "prefix": "smethod", "body": ["static method<${1:Int}> ${2:name}(${3}) {", "\t$0", "}"] },
  "generic method": { "prefix": "methodg", "body": ["method<${1:T}> ${2:first}(List<${1}> ${3:list}) where ${1} {", "\treturn $0", "}"] },
  "bounded generic": { "prefix": "methodb", "body": ["method<${1:T}> ${2:max}(${1} a, ${1} b) where ${1}: Comparable<${1}> {", "\treturn a.compareTo(b) > 0 ? a : b", "}"] },
  "placeholder method": { "prefix": "methodp", "body": ["method<${1:Int}> ${2:name}(${3}) {", "\t...", "}"] },
  "main": { "prefix": "main", "body": ["static method main {", "\t$0", "}"] },
  "abstract method": { "prefix": "amethod", "body": "abstract method<${1:String}> ${2:name}" },
  "override method": { "prefix": "omethod", "body": ["override method<${1:String}> ${2:name} {", "\t$0", "}"] },
  "result method": { "prefix": "resultm", "body": ["method<Result<${1:Int}, ${2:IOException}>> ${3:name}(${4}) {", "\tif (${5:condition}) {", "\t\tfail ${2}(${6})", "\t}", "", "\tsuccess ${7:value}", "}"] },
  "if": { "prefix": "if", "body": ["if (${1:condition}) {", "\t$0", "}"] },
  "guard": { "prefix": "guard", "body": ["if (${1:value} == null) {", "\treturn ${2:null}", "}", "$0"] },
  "while": { "prefix": "while", "body": ["while (${1:condition}) {", "\t$0", "}"] },
  "for": { "prefix": "for", "body": ["for (Int ${1:i} = 0; ${1} < ${2:n}; ${1}++) {", "\t$0", "}"] },
  "foreach": { "prefix": ["foreach", "fore"], "body": ["for (${1:String} ${2:item} in ${3:items}) {", "\t$0", "}"] },
  "switch": { "prefix": "switch", "body": ["switch (${1:value}) {", "\t${2:\"one\"} -> ${3:println(1)}", "\t${4:unknown} -> ${5:println(0)}", "}"] },
  "switch expression": { "prefix": "switche", "body": ["${1:Int} ${2:number} = switch (${3:value}) {", "\t${4:\"one\"} -> ${5:1}", "\t${6:unknown} -> ${7:0}", "}"] },
  "switch result": { "prefix": "switchr", "body": ["switch (${1:result}) {", "\tsuccess(${2:value}) -> ${3:println(value)}", "\terror(${4:exception}) -> ${5:errprintln(exception.message)}", "}"] },
  "switch result typed": { "prefix": "switchrt", "body": ["switch (${1:result}) {", "\tsuccess(${2:value}) -> ${3:println(value)}", "\terror(${4:SpecificException} ${5:e}) -> ${6:errprintln(e.message)}", "\terror(${7:IOException} ${8:e}) -> ${9:errprintln(e.message)}", "}"] },
  "switch enum": { "prefix": "switchenum", "body": ["return switch (${1:rank}) {", "\t${2:MEMBER} -> ${3:\"Mitglied\"}", "\t${4:ADMIN} -> ${5:\"Administrator\"}", "}"] },
  "fail": { "prefix": "fail", "body": "fail ${1:IOException}(${2})" },
  "success": { "prefix": "success", "body": "success ${1:value}" },
  "propagate": { "prefix": "propagate", "body": "${1:String} ${2:text} = ${3:readConfig(path)}?" },
  "unwrap": { "prefix": "unwrap", "body": "${1:Int} ${2:port} = ${3:parsePort(\"25565\")}!" },
  "cascade": { "prefix": "cascade", "body": ["${1:Person} ${2:person} = ${1}(${3})", "\t..${4:birthday}()", "\t..${5:age} = ${6:40}"] },
  "destructure": { "prefix": "destructure", "body": "var { ${1:x}, ${2:y} } = ${3:position}" },
  "lambda": { "prefix": "lambda", "body": "(${1:x}) -> ${2:x * 2}" },
  "lambda block": { "prefix": "lambdab", "body": ["(${1:x}) -> {", "\t$0", "}"] },
  "list": { "prefix": "list", "body": "List<${1:Int}> ${2:numbers} = [${3:1, 2, 3}]" },
  "dictionary": { "prefix": "dict", "body": ["Dictionary<${1:String}, ${2:dynamic}> ${3:server} = {", "\t\"${4:name}\": ${5:value}", "}"] },
  "tuple": { "prefix": "tuple", "body": "[${1:Int}, ${2:String}] ${3:pair} = [${4:42}, ${5:\"Jason\"}]" },
  "println": { "prefix": ["println", "pl"], "body": "println(${1:\"$0\"})" },
  "interpolation": { "prefix": "interp", "body": "\"${1:text} \\${${2:value}}\"" },
  "panic": { "prefix": "panic", "body": "panic(\"${1:message}\")" },
  "fiber": { "prefix": "fiber", "body": ["var ${1:task} = fiber {", "\treturn ${2:value}", "}"] },
  "virtual": { "prefix": "virtual", "body": ["var ${1:task} = virtual {", "\treturn ${2:value}", "}"] },
  "thread": { "prefix": "thread", "body": ["var ${1:task} = thread {", "\treturn ${2:value}", "}"] },
  "await": { "prefix": "await", "body": "${1:task}.await()" },
  "scoped": { "prefix": "scoped", "body": "scoped var ${1:file} = ${2:Files.open(path)}" },
  "macro": { "prefix": "macro", "body": ["macro ${1:Name}(${2}) on ${3:Method} {", "\t$0", "}"] },
  "macro prepend": { "prefix": "macrop", "body": ["macro ${1:Trace} on Method {", "\ttarget.body.prepend(quote statement {", "\t\t${2:println(\"Method entered\")}", "\t})", "}"] },
  "macro addMethod": { "prefix": "macrom", "body": ["macro ${1:GenerateId} on Class {", "\ttarget.addMethod(quote method {", "\t\tmethod<${2:Int}> ${3:getId} {", "\t\t\treturn ${4:this.id}", "\t\t}", "\t})", "}"] },
  "quote statement": { "prefix": "quotes", "body": ["quote statement {", "\t$0", "}"] },
  "quote expression": { "prefix": "quotee", "body": ["quote expression {", "\t$0", "}"] },
  "quote method": { "prefix": "quotem", "body": ["quote method {", "\tmethod<${1:Int}> ${2:name} {", "\t\t$0", "\t}", "}"] },
  "quote field": { "prefix": "quotef", "body": ["quote field {", "\t${1:Int} ${2:id} = ${3:0}", "}"] },
  "splice": { "prefix": "splice", "body": "$(${1:expr})" },
  "annotation": { "prefix": "@", "body": "@${1:Name}" }
}
