{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Emvus",
  "scopeName": "source.emvus",
  "fileTypes": ["ev"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#package" },
    { "include": "#use" },
    { "include": "#annotation" },
    { "include": "#declarations" },
    { "include": "#method-decl" },
    { "include": "#quote" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtin-types" },
    { "include": "#lambda" },
    { "include": "#placeholder" },
    { "include": "#cascade" },
    { "include": "#type-ref" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.emvus", "match": "//.*$" },
        { "name": "comment.block.emvus", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "package": {
      "match": "\\b(package)\\s+([A-Za-z_][\\w]*(?:\\.[A-Za-z_][\\w]*)*)",
      "captures": {
        "1": { "name": "keyword.other.package.emvus" },
        "2": { "name": "entity.name.namespace.emvus" }
      }
    },
    "use": {
      "patterns": [
        {
          "begin": "\\b(use)\\s*(\\{)",
          "beginCaptures": { "1": { "name": "keyword.control.import.emvus" }, "2": { "name": "punctuation.section.block.begin.emvus" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.block.end.emvus" } },
          "patterns": [
            { "include": "#comments" },
            { "match": "\\bas\\b", "name": "keyword.control.as.emvus" },
            { "match": "\\[|\\]", "name": "punctuation.section.group.emvus" },
            { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "entity.name.type.emvus" },
            { "match": "\\b[A-Za-z_][\\w]*\\b", "name": "entity.name.namespace.emvus" },
            { "match": "[.,]", "name": "punctuation.separator.emvus" }
          ]
        },
        {
          "match": "\\b(use)\\s+([A-Za-z_][\\w]*(?:\\.[A-Za-z_][\\w]*)*)(?:\\s+(as)\\s+([A-Za-z_]\\w*))?",
          "captures": {
            "1": { "name": "keyword.control.import.emvus" },
            "2": { "name": "entity.name.namespace.emvus" },
            "3": { "name": "keyword.control.as.emvus" },
            "4": { "name": "entity.name.type.alias.emvus" }
          }
        }
      ]
    },
    "annotation": {
      "match": "(@)([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.emvus" },
        "2": { "name": "storage.type.annotation.emvus" }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(data)\\s+(class)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.modifier.data.emvus" },
            "2": { "name": "storage.type.class.emvus" },
            "3": { "name": "entity.name.type.class.emvus" }
          }
        },
        {
          "match": "\\b(class|interface|enum|record|exception)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.class.emvus" },
            "2": { "name": "entity.name.type.class.emvus" }
          }
        },
        {
          "match": "\\b(macro)\\s+([A-Za-z_]\\w*)(?:\\s*\\([^)]*\\))?\\s+(on)\\b",
          "captures": {
            "1": { "name": "storage.type.macro.emvus" },
            "2": { "name": "entity.name.function.macro.emvus" },
            "3": { "name": "keyword.control.on.emvus" }
          }
        },
        { "match": "\\b(where|based|implements)\\b", "name": "storage.modifier.inheritance.emvus" }
      ]
    },
    "method-decl": {
      "match": "\\b(method)\\b(?:\\s*<[^>]*(?:<[^>]*>[^>]*)*>)?\\s*([A-Za-z_]\\w*)?",
      "captures": {
        "1": { "name": "storage.type.function.emvus" },
        "2": { "name": "entity.name.function.emvus" }
      }
    },
    "quote": {
      "patterns": [
        {
          "match": "\\b(quote)\\s+(statement|expression|field|method|class)\\b",
          "captures": {
            "1": { "name": "keyword.other.quote.emvus" },
            "2": { "name": "entity.name.tag.quote-kind.emvus" }
          }
        },
        { "match": "(\\$)(?=\\()", "name": "keyword.operator.splice.emvus" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.emvus",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.emvus" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.emvus" } },
      "patterns": [
        { "name": "constant.character.escape.emvus", "match": "\\\\." },
        {
          "name": "meta.embedded.interpolation.emvus",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.emvus" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.emvus" } },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#keywords" },
            { "include": "#constants" },
            { "include": "#builtin-types" },
            { "include": "#type-ref" },
            { "include": "#calls" },
            { "include": "#operators" },
            { "match": "\\b[A-Za-z_]\\w*\\b", "name": "variable.other.emvus" },
            { "match": "[.,()\\[\\]]", "name": "punctuation.separator.emvus" }
          ]
        },
        {
          "name": "meta.embedded.splice.emvus",
          "begin": "\\$\\(",
          "end": "\\)",
          "beginCaptures": { "0": { "name": "keyword.operator.splice.emvus" } },
          "endCaptures": { "0": { "name": "keyword.operator.splice.emvus" } },
          "patterns": [
            { "match": "\\b[A-Za-z_]\\w*\\b", "name": "variable.other.emvus" },
            { "match": "[.,]", "name": "punctuation.separator.emvus" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.emvus", "match": "\\b\\d+(?:\\.\\d+)?[eE][+-]?\\d+\\b|\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.emvus", "match": "\\b\\d+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.flow.emvus", "match": "\\b(if|while|for|in|switch|return|break|continue)\\b" },
        { "name": "keyword.control.result.emvus", "match": "\\b(fail|success|error)\\b(?=\\s|\\()" },
        { "name": "keyword.operator.type-test.emvus", "match": "\\b(is|as)\\b" },
        { "name": "storage.modifier.emvus", "match": "\\b(public|private|protected|static|abstract|override|final|scoped)\\b" },
        { "name": "storage.type.var.emvus", "match": "\\b(var|dynamic)\\b" },
        { "name": "keyword.other.task.emvus", "match": "\\b(fiber|virtual|thread)\\b(?=\\s*\\{)" },
        { "name": "variable.language.this.emvus", "match": "\\b(this|super)\\b" },
        { "name": "support.function.builtin.emvus", "match": "\\b(println|print|errprintln|panic)\\b(?=\\s*\\()" },
        { "name": "keyword.other.await.emvus", "match": "(?<=\\.)\\s*(await)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.emvus" },
        { "match": "\\bnull\\b", "name": "constant.language.null.emvus" }
      ]
    },
    "builtin-types": {
      "match": "\\b(Any|Int|Float|String|Boolean|Char|Void|List|Dictionary|Result|Fiber|VirtualThread|Thread|Files|Function|BiFunction|Runnable|Tuple|Comparable|Serializable|IPredicate|IList|IIterator|IIterable|ListIterator|Exception|IOException|UnknownCaseException|Macro|Statement|Expression|Parameter|Method|Process)\\b",
      "name": "support.type.builtin.emvus"
    },
    "lambda": {
      "match": "->",
      "name": "storage.type.function.arrow.emvus"
    },
    "placeholder": {
      "match": "\\.\\.\\.",
      "name": "keyword.other.placeholder.emvus"
    },
    "cascade": {
      "match": "(\\.\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.operator.cascade.emvus" },
        "2": { "name": "variable.other.property.emvus" }
      }
    },
    "type-ref": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?!\\s*\\()",
      "name": "entity.name.type.emvus"
    },
    "calls": {
      "patterns": [
        { "match": "(?<=\\.)\\s*([A-Za-z_]\\w*)(?=\\s*\\()", "captures": { "1": { "name": "entity.name.function.member.emvus" } } },
        { "match": "\\b([A-Z][A-Za-z0-9_]*)(?=\\s*\\()", "name": "entity.name.function.constructor.emvus" },
        { "match": "\\b([a-z_]\\w*)(?=\\s*\\()", "name": "entity.name.function.emvus" },
        { "match": "(?<=\\.)\\s*([A-Za-z_]\\w*)\\b", "captures": { "1": { "name": "variable.other.property.emvus" } } }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.logical.emvus", "match": "&&|\\|\\||!(?!=)" },
        { "name": "keyword.operator.comparison.emvus", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.emvus", "match": "\\+=|-=|\\*=|/=|%=|=" },
        { "name": "keyword.operator.increment.emvus", "match": "\\+\\+|--" },
        { "name": "keyword.operator.arithmetic.emvus", "match": "[-+*/%]" },
        { "name": "keyword.operator.ternary.emvus", "match": "\\?|:" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.accessor.emvus", "match": "\\." },
        { "name": "punctuation.separator.comma.emvus", "match": "," },
        { "name": "punctuation.terminator.statement.emvus", "match": ";" }
      ]
    }
  }
}
