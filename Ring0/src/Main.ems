use ring0::binding::Binder;
use ring0::binding::BindingPrelude;
use ring0::binding::TypeDump;
use ring0::diagnostic::DiagnosticBag;
use ring0::syntax::Lexer;
use ring0::syntax::Node;
use ring0::syntax::SourceSet;
use ring0::syntax::Token;
use Std::Io::File;
use Std::Process::Process;

// Ring0: bootstrap compiler for Emvus, written in Emerald.
// Usage: ring0 <file.ev>... [--tokens | --ast | --check [--types]]
// Several files form one program; --tokens reads the first file only.
main() {
    List<String> args = Process.args();

    Int sources = SourceSet.leadingSources(args);

    if (sources < 1) {
        println("Usage: ring0 <file.ev>... [--tokens | --check [--types]]");
        Process.exit(1);
    }

    Int existing = 0;

    while (existing < sources) {
        if (!File(args.get(existing)).exists()) {
            println("Source file does not exist: " + args.get(existing));
            Process.exit(1);
        }

        existing = existing + 1;
    }

    DiagnosticBag bag = DiagnosticBag();

    if (args.length() > sources && args.get(sources) == "--tokens") {
        Lexer lexer = Lexer(File(args.get(0)).readText(), bag);
        List<Token> tokens = lexer.tokenize();
        Int index = 0;

        while (index < tokens.length()) {
            Token token = tokens.get(index);
            println(token.line().toString() + ":" + token.column().toString() + " " + token.kind() + " " + token.text());
            index = index + 1;
        }

        println("tokens: " + tokens.length().toString());
        bag.printAll();

        if (bag.hasErrors()) {
            Process.exit(1);
        }

        return;
    }

    Node tree = SourceSet.parseAll(args, sources, bag);

    if (bag.hasErrors()) {
        SourceSet.printIndex(args, sources, bag);
        bag.printAll();
        Process.exit(1);
    }

    if (args.length() > sources && args.get(sources) == "--ast") {
        println(tree.dumpEscaped(0));
        return;
    }

    if (args.length() > sources && args.get(sources) == "--check") {
        if (!bag.hasErrors()) {
            Binder binder = Binder(bag);
            binder.bind(tree);
        }

        SourceSet.printIndex(args, sources, bag);
        bag.printAll();

        if (bag.hasErrors()) {
            Process.exit(1);
        }

        if (args.length() > sources + 1 && args.get(sources + 1) == "--types") {
            TypeDump typeDump = TypeDump();
            println(typeDump.dump(tree));
        }

        println("check ok");
        return;
    }

    println(tree.dump(0));
    bag.printAll();

    if (bag.hasErrors()) {
        Process.exit(1);
    }
}
