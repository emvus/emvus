namespace ring0::syntax;

use ring0::syntax::ExpressionParser;
use ring0::syntax::Node;
use ring0::syntax::ParserState;
use ring0::syntax::Token;
use ring0::syntax::TypeParser;
// Helper parser for declarations: words, annotations, modifiers, parameters, where, type lists.
//
// Knotenarten:
//   annotation    text=name, children: argument expressions
//   modifiers     text="" ; children: modifier (text=public|private|protected|static|abstract|override|final)
//   params        children: param (text=name; children: annotation*, modifiers, type node, [default expression])
//   where         children: typeparam (text=name; children: type nodes as bounds)
//   types         children: type nodes (for based/implements)
public class DeclHeaderParser {
    private ParserState state;

    public DeclHeaderParser(ParserState parserState) {
        this.state = parserState;
    }

    // Keyword or identifier with this text (regardless of token kind)
    public Bool isWord(Int offset, String text) {
        Token token = this.state.peekAt(offset);

        if (!token.kindIs("identifier") && !token.kindIs("keyword")) {
            return false;
        }

        return token.text() == text;
    }

    public Bool isNameAt(Int offset) {
        Token token = this.state.peekAt(offset);
        return token.kindIs("identifier") || token.kindIs("keyword");
    }

    public Bool matchWord(String text) {
        if (this.isWord(0, text)) {
            this.state.advance();
            return true;
        }

        return false;
    }

    public Token consumeName(String message) {
        if (this.isNameAt(0)) {
            return this.state.advance();
        }

        this.state.errorHere(message);
        return this.state.peek();
    }

    // a.b.c
    public String parseQualifiedName(String message) {
        String value = this.consumeName(message).text();

        while (this.state.checkSymbol(".") && this.isNameAt(1)) {
            this.state.advance();
            value = value + "." + this.state.advance().text();
        }

        return value;
    }

    // Number of tokens that make up "..." at offset (0 = no placeholder)
    public Int placeholderLength(Int offset) {
        if (this.state.peekAt(offset).isSymbol("...")) {
            return 1;
        }

        if (this.state.peekAt(offset).isSymbol("..") && this.state.peekAt(offset + 1).isSymbol(".")) {
            return 2;
        }

        if (this.state.peekAt(offset).isSymbol(".") && this.state.peekAt(offset + 1).isSymbol(".") && this.state.peekAt(offset + 2).isSymbol(".")) {
            return 3;
        }

        return 0;
    }

    // @Name or @Name(args): attaches an annotation node to owner
    public Void parseAnnotations(Node owner) {
        while (this.state.checkSymbol("@")) {
            Token at = this.state.advance();
            String name = this.parseQualifiedName("Expected annotation name after '@'");
            Node annotation = this.state.nodeAt(at, "annotation", name);

            if (this.state.checkSymbol("(")) {
                this.state.advance();

                while (!this.state.checkSymbol(")") && !this.state.isAtEnd()) {
                    ExpressionParser expressions = ExpressionParser(this.state);
                    annotation.add(expressions.parse());

                    if (!this.state.matchSymbol(",")) {
                        break;
                    }
                }

                this.state.consumeSymbol(")", "Expected ')' after annotation arguments");
            }

            owner.add(annotation);
        }
    }

    public Bool isModifierAt(Int offset) {
        if (this.isWord(offset, "public")) {
            return true;
        }

        if (this.isWord(offset, "private")) {
            return true;
        }

        if (this.isWord(offset, "protected")) {
            return true;
        }

        if (this.isWord(offset, "static")) {
            return true;
        }

        if (this.isWord(offset, "abstract")) {
            return true;
        }

        if (this.isWord(offset, "override")) {
            return true;
        }

        return this.isWord(offset, "final");
    }

    public Node parseModifiers() {
        Node modifiers = this.state.node("modifiers", "");

        while (this.isModifierAt(0)) {
            Token token = this.state.advance();
            modifiers.add(this.state.nodeAt(token, "modifier", token.text()));
        }

        return modifiers;
    }

    // (Type name [= default], ...); expects "("
    public Node parseParams() {
        Node params = this.state.node("params", "");
        this.state.consumeSymbol("(", "Expected '(' before parameters");

        while (!this.state.checkSymbol(")") && !this.state.isAtEnd()) {
            Node holder = this.state.node("holder", "");
            this.parseAnnotations(holder);
            Node modifiers = this.parseModifiers();

            TypeParser types = TypeParser(this.state);
            Node typeNode = types.parse();
            Token nameToken = this.consumeName("Expected parameter name");
            Node param = this.state.nodeAt(nameToken, "param", nameToken.text());

            Int index = 0;

            while (index < holder.count()) {
                param.add(holder.child(index));
                index = index + 1;
            }

            param.add(modifiers);
            param.add(typeNode);

            if (this.state.matchSymbol("=")) {
                ExpressionParser expressions = ExpressionParser(this.state);
                param.add(expressions.parse());
            }

            params.add(param);

            if (!this.state.matchSymbol(",")) {
                break;
            }
        }

        this.state.consumeSymbol(")", "Expected ')' after parameters");
        return params;
    }

    // where T, U: A & B   - callers must check isWord(0, "where") first
    public Node parseWhere() {
        Token keyword = this.state.advance();
        Node where = this.state.nodeAt(keyword, "where", "");

        while (this.isNameAt(0)) {
            Token nameToken = this.state.advance();
            Node parameter = this.state.nodeAt(nameToken, "typeparam", nameToken.text());

            if (this.state.matchSymbol(":")) {
                TypeParser types = TypeParser(this.state);
                parameter.add(types.parse());

                while (this.state.matchSymbol("&")) {
                    parameter.add(types.parse());
                }
            }

            where.add(parameter);

            if (!this.state.matchSymbol(",")) {
                break;
            }
        }

        return where;
    }

    // A, B, C  (at least one type)
    public Node parseTypeList(String kind) {
        Node list = this.state.node(kind, "");
        TypeParser types = TypeParser(this.state);
        list.add(types.parse());

        while (this.state.matchSymbol(",")) {
            list.add(types.parse());
        }

        return list;
    }

    // Attaches annotations (from holder) and modifiers to the declaration
    public Void attach(Node declaration, Node holder, Node modifiers) {
        Int index = 0;

        while (index < holder.count()) {
            declaration.add(holder.child(index));
            index = index + 1;
        }

        declaration.add(modifiers);
    }
}
