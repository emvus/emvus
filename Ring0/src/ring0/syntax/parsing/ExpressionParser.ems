namespace ring0::syntax;

// Node kinds (kind, text, children):
//   string          text=raw text; children: interpolation [expression] per successfully parsed ${...}
//   int-literal / float-literal / bool-literal / null-literal   text=value
//   name            text=identifier (also this, super)
//   this            -
//   generic-ref     text=name, children=type arguments   (only before '(', e.g. Tuple<Int, Int>(1, 2))
//   placeholder     '...'
//   splice          [expression]                      $(expression) in macro code
//   member          text=name, [object]
//   call            [Callee, Arg...]
//   index           [Objekt, Index]
//   propagate       [expression]                      result?
//   unwrap          [expression]                      result!
//   postfix         text=++|--, [expression]
//   unary           text=!|-|+|++|--, [expression]
//   binary          text=Operator, [links, rechts]
//   ternary         [Bedingung, Dann, Sonst]
//   assign          text==|+=|-=|*=|/=|%=, [target, value]
//   is              [expression, type]
//   as              [expression, type]
//   cascade         [Ziel, cascade-section...]
//   cascade-section [member/call chain relative to the target, optionally assign]
//   lambda          [params, body]  params: children "param" (text=name, optional [type]); body: expression or "block"
//   list-literal    [elements...]   (list or tuple, typing decides)
//   dict-literal    [dict-entry...]
//   dict-entry      text="computed" for [expr]: value, otherwise ""; [key, value]
//   task            text=fiber|virtual|thread, [block]
//   switch          [Subjekt, case...]
//   case            [patterns, Body]  patterns: children "pattern" / "pattern-literal"; body: expression | block | success | fail | return | break | continue
//   pattern         text=name (dotted), children "binding" (text=name, optional [type])
//   pattern-literal [Literal]
//   success / fail  [expression]  (also as a switch branch)
//   return          [expression?]  only as a switch branch
//   break / continue
//   quote           text=statement|expression|field|method|class, [block | expression | member...]
//   error           Platzhalter nach Syntaxfehler
public class ExpressionParser {
    private ParserState state;

    public ExpressionParser(ParserState parserState) {
        this.state = parserState;
    }

    public Node parse() {
        return this.parseAssignment();
    }

    // switch (x) { ... } starting at the 'switch' keyword; also usable for statement switches
    public Node parseSwitch() {
        Token start = this.state.advance();
        Node node = this.state.nodeAt(start, "switch", "");
        this.state.consumeSymbol("(", "Expected '(' after switch");
        node.add(this.parse());
        this.state.consumeSymbol(")", "Expected ')' after switch subject");
        this.state.consumeSymbol("{", "Expected '{' to open switch");

        while (!this.state.checkSymbol("}") && !this.state.isAtEnd()) {
            Int before = this.state.position();
            node.add(this.parseCase());

            if (this.state.position() == before) {
                this.state.advance();
            }
        }

        this.state.consumeSymbol("}", "Expected '}' to close switch");
        return node;
    }

    // ---------------------------------------------------------------
    // Operatorebenen
    // ---------------------------------------------------------------

    private Node parseAssignment() {
        Node left = this.parseTernary();
        Token token = this.state.peek();

        if (!token.kindIs("symbol")) {
            return left;
        }

        String op = token.text();

        if (op == "=" || op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=") {
            this.state.advance();
            Node value = this.parseAssignment();
            Node assign = this.state.nodeAt(token, "assign", op);
            assign.add(left);
            assign.add(value);
            return assign;
        }

        return left;
    }

    private Node parseTernary() {
        Node condition = this.parseOr();

        if (!this.state.checkSymbol("?")) {
            return condition;
        }

        Token question = this.state.peek();
        Node ternary = this.state.nodeAt(question, "ternary", "");
        this.state.advance();
        Node thenBranch = this.parseAssignment();
        this.state.consumeSymbol(":", "Expected ':' in conditional expression");
        Node elseBranch = this.parseAssignment();
        ternary.add(condition);
        ternary.add(thenBranch);
        ternary.add(elseBranch);
        return ternary;
    }

    private Node parseOr() {
        return this.parseOrRest(this.parseAnd());
    }

    private Node parseOrRest(Node left) {
        if (!(this.state.checkSymbol("||"))) {
            return left;
        }

        Token op = this.state.advance();
        Node right = this.parseAnd();
        return this.parseOrRest(this.binary(op, left, right));
    }

    private Node parseAnd() {
        return this.parseAndRest(this.parseEquality());
    }

    private Node parseAndRest(Node left) {
        if (!(this.state.checkSymbol("&&"))) {
            return left;
        }

        Token op = this.state.advance();
        Node right = this.parseEquality();
        return this.parseAndRest(this.binary(op, left, right));
    }

    private Node parseEquality() {
        return this.parseEqualityRest(this.parseRelational());
    }

    private Node parseEqualityRest(Node left) {
        if (!(this.state.checkSymbol("==") || this.state.checkSymbol("!="))) {
            return left;
        }

        Token op = this.state.advance();
        Node right = this.parseRelational();
        return this.parseEqualityRest(this.binary(op, left, right));
    }

    private Node parseRelational() {
        return this.parseRelationalRest(this.parseAdditive());
    }

    private Node parseRelationalRest(Node left) {
        Token token = this.state.peek();

        if (token.isSymbol("<") || token.isSymbol(">") || token.isSymbol("<=") || token.isSymbol(">=")) {
            this.state.advance();
            Node right = this.parseAdditive();
            return this.parseRelationalRest(this.binary(token, left, right));
        }

        if (this.isWord(token, "is") || this.isWord(token, "as")) {
            this.state.advance();
            Node typeNode = TypeParser(this.state).parse();
            Node test = this.state.nodeAt(token, token.text(), "");
            test.add(left);
            test.add(typeNode);
            return this.parseRelationalRest(test);
        }

        return left;
    }

    private Node parseAdditive() {
        return this.parseAdditiveRest(this.parseMultiplicative());
    }

    private Node parseAdditiveRest(Node left) {
        if (!(this.state.checkSymbol("+") || this.state.checkSymbol("-"))) {
            return left;
        }

        Token op = this.state.advance();
        Node right = this.parseMultiplicative();
        return this.parseAdditiveRest(this.binary(op, left, right));
    }

    private Node parseMultiplicative() {
        return this.parseMultiplicativeRest(this.parseUnary());
    }

    private Node parseMultiplicativeRest(Node left) {
        if (!(this.state.checkSymbol("*") || this.state.checkSymbol("/") || this.state.checkSymbol("%"))) {
            return left;
        }

        Token op = this.state.advance();
        Node right = this.parseUnary();
        return this.parseMultiplicativeRest(this.binary(op, left, right));
    }

    private Node parseUnary() {
        Token token = this.state.peek();

        if (token.isSymbol("!") || token.isSymbol("-") || token.isSymbol("+") || token.isSymbol("++") || token.isSymbol("--")) {
            this.state.advance();
            Node operand = this.parseUnary();
            Node unary = this.state.nodeAt(token, "unary", token.text());
            unary.add(operand);
            return unary;
        }

        return this.parsePostfix();
    }

    private Node binary(Token op, Node left, Node right) {
        Node node = this.state.nodeAt(op, "binary", op.text());
        node.add(left);
        node.add(right);
        return node;
    }

    // ---------------------------------------------------------------
    // Postfix, Cascade
    // ---------------------------------------------------------------

    private Node parsePostfix() {
        Node start = this.parsePrimary();
        Node chained = this.parsePostfixChain(start);

        if (!this.state.checkSymbol("..")) {
            return chained;
        }

        Node cascade = this.state.node("cascade", "");
        cascade.add(chained);

        while (this.state.checkSymbol("..")) {
            Token dots = this.state.advance();
            Node section = this.state.nodeAt(dots, "cascade-section", "");
            section.add(this.parseCascadeSection());
            cascade.add(section);
        }

        return cascade;
    }

    private Node parseCascadeSection() {
        Token first = this.state.peek();

        if (!this.isWordToken(first)) {
            this.state.errorHere("Expected member name after '..'");
            return this.state.nodeAt(first, "error", "");
        }

        this.state.advance();
        Node chain = this.parsePostfixChain(this.state.nodeAt(first, "name", first.text()));

        if (this.state.checkSymbol("=")) {
            Token eq = this.state.advance();
            Node value = this.parseAssignment();
            Node assign = this.state.nodeAt(eq, "assign", "=");
            assign.add(chain);
            assign.add(value);
            return assign;
        }

        return chain;
    }

    private Node parsePostfixChain(Node left) {
        Token token = this.state.peek();
        Token previous = this.state.peekAt(-1);
        Bool sameLine = token.line() == previous.line();

        if (token.isSymbol(".") && this.isWordToken(this.state.peekAt(1))) {
            Token name = this.state.peekAt(1);
            this.state.advance();
            this.state.advance();
            Node member = this.state.nodeAt(name, "member", name.text());
            member.add(left);
            return this.parsePostfixChain(member);
        }

        if (token.isSymbol("(") && sameLine) {
            return this.parsePostfixChain(this.parseCall(left));
        }

        if (token.isSymbol("[") && sameLine) {
            this.state.advance();
            Node index = this.state.nodeAt(token, "index", "");
            index.add(left);
            index.add(this.parse());
            this.state.consumeSymbol("]", "Expected ']' after index");
            return this.parsePostfixChain(index);
        }

        if (token.isSymbol("?") && this.isPropagate(token)) {
            this.state.advance();
            Node propagate = this.state.nodeAt(token, "propagate", "");
            propagate.add(left);
            return this.parsePostfixChain(propagate);
        }

        if (token.isSymbol("!") && sameLine) {
            this.state.advance();
            Node unwrap = this.state.nodeAt(token, "unwrap", "");
            unwrap.add(left);
            return this.parsePostfixChain(unwrap);
        }

        if ((token.isSymbol("++") || token.isSymbol("--")) && sameLine) {
            this.state.advance();
            Node postfix = this.state.nodeAt(token, "postfix", token.text());
            postfix.add(left);
            return this.parsePostfixChain(postfix);
        }

        return left;
    }

    // '?' is propagation when no expression continues after it (line end, bracket, ...);
    // otherwise it is the ternary operator.
    private Bool isPropagate(Token question) {
        Token next = this.state.peekAt(1);

        if (next.kindIs("eof")) {
            return true;
        }

        if (next.line() != question.line()) {
            return !this.continuesTernary(question);
        }

        if (!next.kindIs("symbol")) {
            return false;
        }

        String text = next.text();
        return text == ")" || text == "]" || text == "}" || text == ";" || text == "," || text == "." || text == "?" || text == ":";
    }

    // '?' at line end: ternary only if a ':' at bracket depth 0 follows before another '?' or the
    // end of the statement (at most 3 lines ahead).
    private Bool continuesTernary(Token question) {
        Int offset = 1;
        Int depth = 0;
        Int limitLine = question.line() + 3;

        while (offset < 64) {
            Token token = this.state.peekAt(offset);

            if (token.kindIs("eof") || token.line() > limitLine) {
                return false;
            }

            if (token.kindIs("symbol")) {
                String text = token.text();

                if (text == "(" || text == "[" || text == "{") {
                    depth = depth + 1;
                }

                if (text == ")" || text == "]" || text == "}") {
                    if (depth == 0) {
                        return false;
                    }

                    depth = depth - 1;
                }

                if (depth == 0 && text == ":") {
                    return true;
                }

                if (depth == 0 && (text == "?" || text == ";" || text == "->" || text == "=")) {
                    return false;
                }
            }

            offset = offset + 1;
        }

        return false;
    }

    // "..${expr}..": the text stays raw in text; every successfully parsed ${...} becomes a
    // child "interpolation" [expression]. Unparseable parts (e.g. $(...) in macros) stay raw.
    private Node parseStringParts(Token token) {
        Node node = this.state.nodeAt(token, "string", token.text());
        String text = token.text();
        Int index = 0;

        while (index + 1 < text.length()) {
            if (text.charAt(index).toString() == "$" && text.charAt(index + 1).toString() == "{") {
                Int close = this.findInterpolationEnd(text, index + 2);

                if (close < 0) {
                    return node;
                }

                Node part = this.parseInterpolation(token, text.substring(index + 2, close));

                if (part.kindIs("interpolation")) {
                    node.add(part);
                }

                index = close + 1;
                continue;
            }

            index = index + 1;
        }

        return node;
    }

    private Int findInterpolationEnd(String text, Int start) {
        Int depth = 0;
        Int index = start;

        while (index < text.length()) {
            String c = text.charAt(index).toString();

            if (c == "{") {
                depth = depth + 1;
            }

            if (c == "}") {
                if (depth == 0) {
                    return index;
                }

                depth = depth - 1;
            }

            index = index + 1;
        }

        return -1;
    }

    private Node parseInterpolation(Token origin, String source) {
        DiagnosticBag scratch = DiagnosticBag();
        List<Token> tokens = Lexer(source, scratch).tokenize();
        ParserState inner = ParserState(tokens, scratch);
        Node expression = ExpressionParser(inner).parse();

        if (scratch.hasErrors() || !inner.isAtEnd()) {
            return this.state.nodeAt(origin, "raw", "");
        }

        Node part = this.state.nodeAt(origin, "interpolation", "");
        part.add(expression);
        return part;
    }

    private Node parseCall(Node callee) {
        Token open = this.state.advance();
        Node call = this.state.nodeAt(open, "call", "");
        call.add(callee);

        if (!this.state.checkSymbol(")")) {
            Bool more = true;

            while (more) {
                call.add(this.parse());
                more = this.state.matchSymbol(",");

                if (more && this.state.checkSymbol(")")) {
                    more = false;
                }
            }
        }

        this.state.consumeSymbol(")", "Expected ')' after arguments");
        return call;
    }

    // ---------------------------------------------------------------
    // Primary expressions
    // ---------------------------------------------------------------

    private Node parsePrimary() {
        Token token = this.state.peek();

        if (token.kindIs("number")) {
            this.state.advance();
            return this.state.nodeAt(token, "int-literal", token.text());
        }

        if (token.kindIs("float")) {
            this.state.advance();
            return this.state.nodeAt(token, "float-literal", token.text());
        }

        if (token.kindIs("string")) {
            this.state.advance();
            return this.parseStringParts(token);
        }

        if (token.isSymbol("(")) {
            return this.parseParenthesized();
        }

        if (token.isSymbol("[")) {
            return this.parseListLiteral();
        }

        if (token.isSymbol("{")) {
            return this.parseDictionary();
        }

        if (token.isSymbol("...")) {
            this.state.advance();
            return this.state.nodeAt(token, "placeholder", "");
        }

        if (token.isSymbol("..") && this.state.peekAt(1).isSymbol(".")) {
            this.state.advance();
            this.state.advance();
            return this.state.nodeAt(token, "placeholder", "");
        }

        if (token.isSymbol("$") && this.state.peekAt(1).isSymbol("(")) {
            this.state.advance();
            this.state.advance();
            Node splice = this.state.nodeAt(token, "splice", "");
            splice.add(this.parse());
            this.state.consumeSymbol(")", "Expected ')' after $( expression");
            return splice;
        }

        if (this.isWordToken(token)) {
            return this.parseWord(token);
        }

        this.state.errorHere("Expected expression");
        return this.state.nodeAt(token, "error", "");
    }

    private Node parseWord(Token token) {
        String text = token.text();

        if (text == "true" || text == "false") {
            this.state.advance();
            return this.state.nodeAt(token, "bool-literal", text);
        }

        if (text == "null") {
            this.state.advance();
            return this.state.nodeAt(token, "null-literal", "");
        }

        if (text == "switch" && this.state.peekAt(1).isSymbol("(")) {
            return this.parseSwitch();
        }

        if ((text == "fiber" || text == "virtual" || text == "thread") && this.state.peekAt(1).isSymbol("{")) {
            this.state.advance();
            Node task = this.state.nodeAt(token, "task", text);
            task.add(StatementParser(this.state).parseBlock());
            return task;
        }

        if (text == "quote" && this.isWordToken(this.state.peekAt(1)) && this.state.peekAt(2).isSymbol("{")) {
            return this.parseQuote(token);
        }

        // Einzelner Parameter ohne Klammern: x -> expr
        if (this.state.peekAt(1).isSymbol("->")) {
            return this.parseBareLambda(token);
        }

        // Generischer Aufruf: Tuple<Int, Int>(1, 2)
        if (this.state.peekAt(1).isSymbol("<")) {
            Node generic = this.tryGenericReference(token);

            if (!generic.kindIs("error")) {
                return generic;
            }
        }

        this.state.advance();
        return this.state.nodeAt(token, "name", text);
    }

    private Node tryGenericReference(Token token) {
        Int start = this.state.position();
        this.state.beginSpeculation();
        Node typeNode = TypeParser(this.state).parse();
        Bool ok = this.state.endSpeculation();

        if (ok && this.state.checkSymbol("(")) {
            Node generic = this.state.nodeAt(token, "generic-ref", typeNode.text());
            Int index = 0;

            while (index < typeNode.count()) {
                generic.add(typeNode.child(index));
                index = index + 1;
            }

            return generic;
        }

        this.state.seek(start);
        return this.state.nodeAt(token, "error", "");
    }

    private Node parseParenthesized() {
        if (this.isLambdaAhead()) {
            return this.parseLambda();
        }

        this.state.advance();
        Node inner = this.parse();
        this.state.consumeSymbol(")", "Expected ')' after expression");
        return inner;
    }

    // '(' ... ')' '->' => Lambda
    private Bool isLambdaAhead() {
        Int depth = 0;
        Int offset = 0;

        while (offset < 400) {
            Token token = this.state.peekAt(offset);

            if (token.kindIs("eof")) {
                return false;
            }

            if (token.isSymbol("(")) {
                depth = depth + 1;
            }

            if (token.isSymbol(")")) {
                depth = depth - 1;

                if (depth == 0) {
                    return this.state.peekAt(offset + 1).isSymbol("->");
                }
            }

            offset = offset + 1;
        }

        return false;
    }

    private Node parseLambda() {
        Token open = this.state.advance();
        Node lambda = this.state.nodeAt(open, "lambda", "");
        Node parameters = this.state.nodeAt(open, "params", "");

        if (!this.state.checkSymbol(")")) {
            Bool more = true;

            while (more) {
                Int before = this.state.position();
                parameters.add(this.parseLambdaParameter());

                if (this.state.position() == before) {
                    more = false;
                }

                if (more) {
                    more = this.state.matchSymbol(",");
                }
            }
        }

        this.state.consumeSymbol(")", "Expected ')' after lambda parameters");
        this.state.consumeSymbol("->", "Expected '->' in lambda");
        lambda.add(parameters);
        lambda.add(this.parseLambdaBody());
        return lambda;
    }

    private Node parseBareLambda(Token name) {
        this.state.advance();
        this.state.advance();
        Node lambda = this.state.nodeAt(name, "lambda", "");
        Node parameters = this.state.nodeAt(name, "params", "");
        parameters.add(this.state.nodeAt(name, "param", name.text()));
        lambda.add(parameters);
        lambda.add(this.parseLambdaBody());
        return lambda;
    }

    private Node parseLambdaBody() {
        if (this.state.checkSymbol("{")) {
            return StatementParser(this.state).parseBlock();
        }

        return this.parse();
    }

    private Node parseLambdaParameter() {
        Token first = this.state.peek();
        Int start = this.state.position();
        this.state.beginSpeculation();
        Node typeNode = TypeParser(this.state).parse();
        Bool ok = this.state.endSpeculation();

        if (ok && this.isWordToken(this.state.peek())) {
            Token name = this.state.advance();
            Node param = this.state.nodeAt(name, "param", name.text());
            param.add(typeNode);
            return param;
        }

        this.state.seek(start);

        if (!this.isWordToken(first)) {
            this.state.errorHere("Expected lambda parameter name");
            return this.state.nodeAt(first, "param", "");
        }

        this.state.advance();
        return this.state.nodeAt(first, "param", first.text());
    }

    private Node parseListLiteral() {
        Token open = this.state.advance();
        Node list = this.state.nodeAt(open, "list-literal", "");

        if (!this.state.checkSymbol("]")) {
            Bool more = true;

            while (more) {
                list.add(this.parse());
                more = this.state.matchSymbol(",");

                if (more && this.state.checkSymbol("]")) {
                    more = false;
                }
            }
        }

        this.state.consumeSymbol("]", "Expected ']' after list literal");
        return list;
    }

    private Node parseDictionary() {
        Token open = this.state.advance();
        Node dict = this.state.nodeAt(open, "dict-literal", "");

        if (!this.state.checkSymbol("}")) {
            Bool more = true;

            while (more) {
                dict.add(this.parseDictionaryEntry());
                more = this.state.matchSymbol(",");

                if (more && this.state.checkSymbol("}")) {
                    more = false;
                }
            }
        }

        this.state.consumeSymbol("}", "Expected '}' after dictionary literal");
        return dict;
    }

    private Node parseDictionaryEntry() {
        Token first = this.state.peek();

        if (first.isSymbol("[")) {
            this.state.advance();
            Node computed = this.state.nodeAt(first, "dict-entry", "computed");
            computed.add(this.parse());
            this.state.consumeSymbol("]", "Expected ']' after computed key");
            this.state.consumeSymbol(":", "Expected ':' after dictionary key");
            computed.add(this.parse());
            return computed;
        }

        Node entry = this.state.nodeAt(first, "dict-entry", "");
        entry.add(this.parseOr());
        this.state.consumeSymbol(":", "Expected ':' after dictionary key");
        entry.add(this.parse());
        return entry;
    }

    // ---------------------------------------------------------------
    // switch
    // ---------------------------------------------------------------

    private Node parseCase() {
        Token first = this.state.peek();
        Node node = this.state.nodeAt(first, "case", "");
        Node patterns = this.state.nodeAt(first, "patterns", "");
        Bool more = true;

        while (more) {
            Int before = this.state.position();
            patterns.add(this.parsePattern());

            if (this.state.position() == before) {
                more = false;
            }

            if (more) {
                more = this.state.matchSymbol(",");
            }
        }

        this.state.consumeSymbol("->", "Expected '->' in switch case");
        node.add(patterns);
        node.add(this.parseCaseBody());
        return node;
    }

    private Node parsePattern() {
        Token token = this.state.peek();

        if (token.kindIs("string") || token.kindIs("number") || token.kindIs("float") || token.isSymbol("-")) {
            Node literal = this.state.nodeAt(token, "pattern-literal", "");
            literal.add(this.parseUnary());
            return literal;
        }

        if (!this.isWordToken(token)) {
            this.state.errorHere("Expected switch pattern");
            return this.state.nodeAt(token, "pattern", "");
        }

        this.state.advance();
        String name = token.text();

        while (this.state.checkSymbol(".") && this.isWordToken(this.state.peekAt(1))) {
            this.state.advance();
            name = name + "." + this.state.advance().text();
        }

        Node pattern = this.state.nodeAt(token, "pattern", name);

        if (this.state.checkSymbol("(")) {
            this.state.advance();

            if (!this.state.checkSymbol(")")) {
                Bool more = true;

                while (more) {
                    Int before = this.state.position();
                    pattern.add(this.parseBinding());

                    if (this.state.position() == before) {
                        more = false;
                    }

                    if (more) {
                        more = this.state.matchSymbol(",");
                    }
                }
            }

            this.state.consumeSymbol(")", "Expected ')' after pattern bindings");
        }

        return pattern;
    }

    private Node parseBinding() {
        Token first = this.state.peek();
        Int start = this.state.position();
        this.state.beginSpeculation();
        Node typeNode = TypeParser(this.state).parse();
        Bool ok = this.state.endSpeculation();

        if (ok && this.isWordToken(this.state.peek())) {
            Token name = this.state.advance();
            Node binding = this.state.nodeAt(name, "binding", name.text());
            binding.add(typeNode);
            return binding;
        }

        this.state.seek(start);

        if (!this.isWordToken(first)) {
            this.state.errorHere("Expected binding name");
            return this.state.nodeAt(first, "binding", "");
        }

        this.state.advance();
        return this.state.nodeAt(first, "binding", first.text());
    }

    private Node parseCaseBody() {
        Token token = this.state.peek();

        if (token.isSymbol("{")) {
            return StatementParser(this.state).parseBlock();
        }

        if (this.isWord(token, "fail") || this.isWord(token, "success")) {
            this.state.advance();
            Node node = this.state.nodeAt(token, token.text(), "");
            node.add(this.parse());
            return node;
        }

        if (this.isWord(token, "break") || this.isWord(token, "continue")) {
            this.state.advance();
            return this.state.nodeAt(token, token.text(), "");
        }

        if (this.isWord(token, "return")) {
            this.state.advance();
            Node ret = this.state.nodeAt(token, "return", "");
            Token next = this.state.peek();

            if (next.line() == token.line() && !next.isSymbol("}") && !next.kindIs("eof")) {
                ret.add(this.parse());
            }

            return ret;
        }

        return this.parse();
    }

    // ---------------------------------------------------------------
    // quote
    // ---------------------------------------------------------------

    private Node parseQuote(Token quoteToken) {
        this.state.advance();
        Token kind = this.state.advance();
        Node node = this.state.nodeAt(quoteToken, "quote", kind.text());

        if (kind.text() == "statement") {
            node.add(StatementParser(this.state).parseBlock());
            return node;
        }

        this.state.consumeSymbol("{", "Expected '{' after quote kind");

        if (kind.text() == "expression") {
            node.add(this.parse());
            this.state.consumeSymbol("}", "Expected '}' after quote expression");
            return node;
        }

        TopLevelParser top = TopLevelParser(this.state);

        while (!this.state.checkSymbol("}") && !this.state.isAtEnd()) {
            Int before = this.state.position();
            node.add(top.parseMember());

            if (this.state.position() == before) {
                this.state.advance();
            }
        }

        this.state.consumeSymbol("}", "Expected '}' after quote body");
        return node;
    }

    // ---------------------------------------------------------------

    private Bool isWordToken(Token token) {
        return token.kindIs("identifier") || token.kindIs("keyword");
    }

    private Bool isWord(Token token, String text) {
        return this.isWordToken(token) && token.text() == text;
    }
}
