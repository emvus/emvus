namespace ring0::syntax;

use ring0::syntax::DeclHeaderParser;
use ring0::syntax::ExpressionParser;
use ring0::syntax::Node;
use ring0::syntax::ParserState;
use ring0::syntax::StatementParser;
use ring0::syntax::Token;
use ring0::syntax::TypeParser;
// Mitglieder und Top-Level-Elemente (parseMember) – auch für quote field/method/class.
//
// Knotenarten (Kinder: annotation*, modifiers, dann):
//   method       text=Name  [return-type(Typ-Knoten)] params [where] [block | placeholder]
//   constructor  text=Name  params [super-call(text=super|this; Kinder: Argumente)] block
//   property     text=Name  Typ-Knoten accessors(accessor text=get|set) [Initializer]
//   field        text=Name  Typ-Knoten [Initializer]
//   variable     text=Name  Typ-Knoten (text "var" bei var) [Initializer]   (z.B. final var X = 1)
//   placeholder  ein Body, der nur aus ... besteht
//   Dazu alle Typ-Deklarationen oben (verschachtelte Klassen etc.).
// Typ-Deklarationen: class, data class, interface, enum, record, exception, macro.
// Jede Deklaration hat als Kinder zuerst annotation*, dann modifiers, danach:
//   class       text=Name  [where] [based(types)] [implements(types)] body
//   data-class  text=Name  params [where] [body]
//   record      text=Name  params [body]
//   interface   text=Name  [where] [based(types)] body
//   enum        text=Name  body (enum-entry*, Mitglieder)
//   exception   text=Name  [params] [based(types)] [body]
//   macro       text=Name  params targets(target text=Class|Method|...) block
//   body        Kinder: Mitglieder (siehe DeclMemberParser)
//   enum-entry  text=Name, Kinder: Argumentausdrücke
public class DeclMemberParser {
    private ParserState state;
    private DeclHeaderParser header;

    public DeclMemberParser(ParserState parserState) {
        this.state = parserState;
        this.header = DeclHeaderParser(parserState);
    }

    public Node parseMember() {
        Node holder = this.state.node("holder", "");
        this.header.parseAnnotations(holder);
        Node modifiers = this.header.parseModifiers();
        // Annotationen dürfen auch zwischen Modifiern stehen
        this.header.parseAnnotations(holder);

        Node result = this.parseDeclaration(holder, modifiers);
        this.state.matchSymbol(";");
        return result;
    }

    private Node parseDeclaration(Node holder, Node modifiers) {
        if (this.header.isWord(0, "class")) {
            return this.parseClass(holder, modifiers);
        }

        if (this.header.isWord(0, "data") && this.header.isWord(1, "class")) {
            return this.parseDataClass(holder, modifiers);
        }

        if (this.header.isWord(0, "interface")) {
            return this.parseInterface(holder, modifiers);
        }

        if (this.header.isWord(0, "enum")) {
            return this.parseEnum(holder, modifiers);
        }

        if (this.header.isWord(0, "record") && this.header.isNameAt(1)) {
            return this.parseRecord(holder, modifiers);
        }

        if (this.header.isWord(0, "exception") && this.header.isNameAt(1)) {
            return this.parseException(holder, modifiers);
        }

        if (this.header.isWord(0, "macro") && this.header.isNameAt(1)) {
            return this.parseMacro(holder, modifiers);
        }

        if (this.header.isWord(0, "method")) {
            return this.parseMethod(holder, modifiers);
        }

        if (this.header.isWord(0, "var")) {
            return this.parseVariable(holder, modifiers);
        }

        if (this.state.peek().kindIs("identifier") && this.state.peekAt(1).isSymbol("(")) {
            return this.parseConstructor(holder, modifiers);
        }

        return this.parseField(holder, modifiers);
    }

    // Parameterliste oder leerer params-Knoten, wenn keine Klammer folgt
    private Node parseOptionalParams() {
        if (this.state.checkSymbol("(")) {
            return this.header.parseParams();
        }

        return this.state.node("params", "");
    }

    private Node parseMethod(Node holder, Node modifiers) {
        Token keyword = this.state.advance();
        Node returnType = this.state.node("return-type", "");
        Bool hasReturnType = false;

        if (this.state.checkSymbol("<")) {
            this.state.advance();
            TypeParser typeParser = TypeParser(this.state);
            returnType.add(typeParser.parse());
            this.state.consumeSymbol(">", "Expected '>' after method return type");
            hasReturnType = true;
        }

        Token nameToken = this.header.consumeName("Expected method name");
        Node method = this.state.nodeAt(nameToken, "method", nameToken.text());
        this.header.attach(method, holder, modifiers);

        if (hasReturnType) {
            method.add(returnType);
        }

        method.add(this.parseOptionalParams());

        if (this.header.isWord(0, "where")) {
            method.add(this.header.parseWhere());
        }

        if (this.state.checkSymbol("{")) {
            Int length = this.header.placeholderLength(1);

            if (length > 0 && this.state.peekAt(1 + length).isSymbol("}")) {
                Token open = this.state.advance();
                Int skipped = 0;

                while (skipped < length) {
                    this.state.advance();
                    skipped = skipped + 1;
                }

                this.state.advance();
                method.add(this.state.nodeAt(open, "placeholder", ""));
                return method;
            }

            StatementParser statements = StatementParser(this.state);
            method.add(statements.parseBlock());
        }

        return method;
    }

    private Node parseConstructor(Node holder, Node modifiers) {
        Token nameToken = this.state.advance();
        Node constructor = this.state.nodeAt(nameToken, "constructor", nameToken.text());
        this.header.attach(constructor, holder, modifiers);
        constructor.add(this.header.parseParams());

        if (this.state.matchSymbol(":")) {
            Token target = this.header.consumeName("Expected 'super' or 'this' after ':'");
            Node call = this.state.nodeAt(target, "super-call", target.text());
            this.state.consumeSymbol("(", "Expected '(' after constructor call target");

            while (!this.state.checkSymbol(")") && !this.state.isAtEnd()) {
                ExpressionParser expressions = ExpressionParser(this.state);
                call.add(expressions.parse());

                if (!this.state.matchSymbol(",")) {
                    break;
                }
            }

            this.state.consumeSymbol(")", "Expected ')' after constructor call arguments");
            constructor.add(call);
        }

        StatementParser statements = StatementParser(this.state);
        constructor.add(statements.parseBlock());
        return constructor;
    }

    // var name = expr
    private Node parseVariable(Node holder, Node modifiers) {
        Token keyword = this.state.advance();
        Token nameToken = this.header.consumeName("Expected variable name");
        Node variable = this.state.nodeAt(nameToken, "variable", nameToken.text());
        this.header.attach(variable, holder, modifiers);
        variable.add(this.state.nodeAt(keyword, "type", "var"));

        if (this.state.matchSymbol("=")) {
            ExpressionParser expressions = ExpressionParser(this.state);
            variable.add(expressions.parse());
        }

        return variable;
    }

    // Typ name [{ get, set }] [= expr]
    private Node parseField(Node holder, Node modifiers) {
        TypeParser typeParser = TypeParser(this.state);
        Node typeNode = typeParser.parse();
        Token nameToken = this.header.consumeName("Expected member name");
        Bool accessorBlock = this.state.checkSymbol("{");
        String kind = "field";

        if (accessorBlock) {
            kind = "property";
        }

        Node member = this.state.nodeAt(nameToken, kind, nameToken.text());
        this.header.attach(member, holder, modifiers);
        member.add(typeNode);

        if (accessorBlock) {
            Node accessors = this.state.node("accessors", "");
            this.state.advance();

            while (!this.state.checkSymbol("}") && !this.state.isAtEnd()) {
                String text = "";

                while (this.header.isModifierAt(0)) {
                    text = text + this.state.advance().text() + " ";
                }

                Token word = this.header.consumeName("Expected 'get' or 'set'");
                accessors.add(this.state.nodeAt(word, "accessor", text + word.text()));

                if (!this.state.matchSymbol(",")) {
                    break;
                }
            }

            this.state.consumeSymbol("}", "Expected '}' after accessors");
            member.add(accessors);
        }

        if (this.state.matchSymbol("=")) {
            ExpressionParser expressions = ExpressionParser(this.state);
            member.add(expressions.parse());
        }

        return member;
    }

    // erwartet "{" Mitglieder "}"
    public Node parseBody() {
        Node body = this.state.node("body", "");
        this.state.consumeSymbol("{", "Expected '{' before body");
        
        while (!this.state.checkSymbol("}") && !this.state.isAtEnd()) {
            Int start = this.state.position();
            body.add(this.parseMember());

            if (this.state.position() == start) {
                this.state.advance();
            }
        }

        this.state.consumeSymbol("}", "Expected '}' after body");
        return body;
    }

    private Node begin(String kind, String message, Node holder, Node modifiers) {
        Token nameToken = this.header.consumeName(message);
        Node declaration = this.state.nodeAt(nameToken, kind, nameToken.text());
        this.header.attach(declaration, holder, modifiers);
        return declaration;
    }

    // Header-Klauseln: where, based, implements
    private Void parseClauses(Node declaration, Bool allowImplements) {
        if (this.header.isWord(0, "where")) {
            declaration.add(this.header.parseWhere());
        }

        if (this.header.isWord(0, "based")) {
            this.state.advance();
            declaration.add(this.header.parseTypeList("based"));
        }

        if (allowImplements && this.header.isWord(0, "implements")) {
            this.state.advance();
            declaration.add(this.header.parseTypeList("implements"));
        }

        // where darf auch nach based/implements stehen
        if (this.header.isWord(0, "where")) {
            declaration.add(this.header.parseWhere());
        }
    }

    public Node parseClass(Node holder, Node modifiers) {
        this.state.advance();
        Node declaration = this.begin("class", "Expected class name", holder, modifiers);
        this.parseClauses(declaration, true);
        declaration.add(this.parseBody());
        return declaration;
    }

    public Node parseDataClass(Node holder, Node modifiers) {
        this.state.advance();
        this.state.advance();
        Node declaration = this.begin("data-class", "Expected data class name", holder, modifiers);
        declaration.add(this.header.parseParams());
        this.parseClauses(declaration, true);

        if (this.state.checkSymbol("{")) {
            declaration.add(this.parseBody());
        }

        return declaration;
    }

    public Node parseRecord(Node holder, Node modifiers) {
        this.state.advance();
        Node declaration = this.begin("record", "Expected record name", holder, modifiers);
        declaration.add(this.header.parseParams());
        this.parseClauses(declaration, true);

        if (this.state.checkSymbol("{")) {
            declaration.add(this.parseBody());
        }

        return declaration;
    }

    public Node parseInterface(Node holder, Node modifiers) {
        this.state.advance();
        Node declaration = this.begin("interface", "Expected interface name", holder, modifiers);
        this.parseClauses(declaration, false);
        declaration.add(this.parseBody());
        return declaration;
    }

    public Node parseException(Node holder, Node modifiers) {
        this.state.advance();
        Node declaration = this.begin("exception", "Expected exception name", holder, modifiers);

        if (this.state.checkSymbol("(")) {
            declaration.add(this.header.parseParams());
        }

        this.parseClauses(declaration, false);

        if (this.state.checkSymbol("{")) {
            declaration.add(this.parseBody());
        }

        return declaration;
    }

    public Node parseEnum(Node holder, Node modifiers) {
        this.state.advance();
        Node declaration = this.begin("enum", "Expected enum name", holder, modifiers);
        Node body = this.state.node("body", "");
        this.state.consumeSymbol("{", "Expected '{' before enum body");

        // Einträge bis ';' oder '}'
        while (this.header.isNameAt(0) && !this.state.checkSymbol("}") && !this.state.isAtEnd()) {
            Token nameToken = this.state.advance();
            Node entry = this.state.nodeAt(nameToken, "enum-entry", nameToken.text());

            if (this.state.checkSymbol("(")) {
                this.state.advance();

                while (!this.state.checkSymbol(")") && !this.state.isAtEnd()) {
                    ExpressionParser expressions = ExpressionParser(this.state);
                    entry.add(expressions.parse());

                    if (!this.state.matchSymbol(",")) {
                        break;
                    }
                }

                this.state.consumeSymbol(")", "Expected ')' after enum entry arguments");
            }

            body.add(entry);

            if (!this.state.matchSymbol(",")) {
                break;
            }
        }

        // Mitglieder nach ';'
        if (this.state.matchSymbol(";")) {
            
            while (!this.state.checkSymbol("}") && !this.state.isAtEnd()) {
                Int start = this.state.position();
                body.add(this.parseMember());

                if (this.state.position() == start) {
                    this.state.advance();
                }
            }
        }

        this.state.consumeSymbol("}", "Expected '}' after enum body");
        declaration.add(body);
        return declaration;
    }

    // macro Name(params) on Target, Target { ... }
    public Node parseMacro(Node holder, Node modifiers) {
        this.state.advance();
        Node declaration = this.begin("macro", "Expected macro name", holder, modifiers);

        declaration.add(this.parseOptionalParams());
        Node targets = this.state.node("targets", "");

        if (!this.header.matchWord("on")) {
            this.state.errorHere("Expected 'on' and macro target");
        }

        while (this.header.isNameAt(0) && !this.state.checkSymbol("{")) {
            Token target = this.state.advance();
            targets.add(this.state.nodeAt(target, "target", target.text()));

            if (!this.state.matchSymbol(",")) {
                break;
            }
        }

        declaration.add(targets);
        StatementParser statements = StatementParser(this.state);
        declaration.add(statements.parseBlock());
        return declaration;
    }
}
