namespace ring0::syntax;


// StatementParser: statements and blocks.
//
// API
//   parseBlock()     -> "block"   konsumiert `{ ... }`, Semikolons optional
//   parseStatement() -> statement node, consumes an optional `;`
//
// Produced node kinds (children in order)
//   block         []  Statements
//   empty         []  internal only, for a lone `;` (dropped inside blocks)
//   placeholder   []  `...` Platzhalter-Body
//   local         text=Name; [modifier* (text final|scoped), type|var, init?]
//                 type = node from TypeParser, var = "var" node (inferred), dynamic = "type" node with text "dynamic"
//   init          [expr | cascade]  initializer of local/destructure
//   destructure   [modifier*, (binding | wildcard)+, init]   `var { a, _ } = e`
//   binding       text=Name, wildcard text=_
//   cascade       [expr, cascade-item+]   expression followed by `..` sections
//   cascade-item  [expr]
//   if            [cond-expr, body, else?]   else branch only with the error "else not supported"
//   else          [body]
//   while         [cond-expr, body]
//   for           [init, condition, update, body]   always 4 children; init/condition/update may be empty
//                 init=[statement], condition=[expr], update=[expr*]
//   foreach       text=Variablenname; [type|var, iterable-expr, body]
//   return        [expr?]   value only if it is on the same line as `return`
//   fail          [expr]
//   success       [expr]
//   break, continue  []
//   switch        [subject-expr, case*]
//   case          [pattern+, body]   body = last child (statement or block)
//   pattern-success  [binding|wildcard]?        `success` or `success(x)`
//   pattern-error    [type?, binding|wildcard]? `error`, `error(e)`, `error(Type e)`
//   pattern-name     text=Name                   free name, e.g. `unknown` or an enum constant
//   pattern-value    [expr]                      literal / qualified expression
//   assign        [lhs, rhs]   only if ExpressionParser does not handle `=` itself
//   expr-stmt     [expr | cascade | assign]
public class StatementParser {
    private ParserState state;

    public StatementParser(ParserState parserState) {
        this.state = parserState;
    }

    public Node parseBlock() {
        Node block = this.state.node("block", "");
        this.state.consumeSymbol("{", "Expected '{' to start block");

        while (!this.state.isAtEnd() && !this.state.checkSymbol("}")) {
            Int before = this.state.position();
            Node statement = this.parseStatement();

            if (!statement.kindIs("empty")) {
                block.add(statement);
            }

            if (this.state.position() == before) {
                this.state.advance();
            }
        }

        this.state.consumeSymbol("}", "Expected '}' to end block");
        return block;
    }

    public Node parseStatement() {
        Node statement = this.parseSimpleStatement();

        if (this.state.checkSymbol(";")) {
            this.state.advance();
        }

        return statement;
    }

    private Node parseSimpleStatement() {
        Token token = this.state.peek();

        if (token.isSymbol("{")) {
            return this.parseBlock();
        }

        if (token.isSymbol(";")) {
            this.state.advance();
            return this.state.nodeAt(token, "empty", "");
        }

        if (this.atPlaceholder()) {
            return this.parsePlaceholder();
        }

        if (this.isWord(token, "if")) {
            return this.parseIf();
        }

        if (this.isWord(token, "while")) {
            return this.parseWhile();
        }

        if (this.isWord(token, "for")) {
            return this.parseFor();
        }

        if (this.isWord(token, "switch")) {
            return this.parseSwitch();
        }

        if (this.isWord(token, "return")) {
            return this.parseReturn();
        }

        if (this.isWord(token, "fail")) {
            return this.parseValueStatement("fail");
        }

        if (this.isWord(token, "success")) {
            return this.parseValueStatement("success");
        }

        if (this.isWord(token, "break")) {
            this.state.advance();
            return this.state.nodeAt(token, "break", "");
        }

        if (this.isWord(token, "continue")) {
            this.state.advance();
            return this.state.nodeAt(token, "continue", "");
        }

        if (this.atLocalStart()) {
            return this.parseLocal();
        }

        return this.parseExpressionStatement();
    }

    // ---------------------------------------------------------------
    // Hilfsfunktionen
    // ---------------------------------------------------------------

    private Bool isWord(Token token, String word) {
        if (token.isKeyword(word)) {
            return true;
        }

        return token.isIdentifier(word);
    }

    private Bool atPlaceholder() {
        if (this.state.checkSymbol("...")) {
            return true;
        }

        return this.state.checkSymbol("..") && this.state.peekAt(1).isSymbol(".");
    }

    private Node parsePlaceholder() {
        Token token = this.state.peek();

        if (this.state.checkSymbol("...")) {
            this.state.advance();
        }

        if (this.state.checkSymbol("..")) {
            this.state.advance();
            this.state.advance();
        }

        return this.state.nodeAt(token, "placeholder", "...");
    }

    private Node parseBody() {
        if (this.state.checkSymbol("{")) {
            return this.parseBlock();
        }

        this.state.errorHere("Expected '{': braces are required");
        return this.parseSimpleStatement();
    }

    private Node parseCondition() {
        this.state.consumeSymbol("(", "Expected '(' before condition");
        Node condition = ExpressionParser(this.state).parse();
        this.state.consumeSymbol(")", "Expected ')' after condition");
        return condition;
    }

    private Node absorbCascade(Node target) {
        if (!this.state.checkSymbol("..")) {
            return target;
        }

        if (this.state.peekAt(1).isSymbol(".")) {
            return target;
        }

        Node cascade = this.state.nodeAt(this.state.peek(), "cascade", "");
        cascade.add(target);

        while (this.state.checkSymbol("..") && !this.state.peekAt(1).isSymbol(".")) {
            Token token = this.state.advance();
            Node item = this.state.nodeAt(token, "cascade-item", "");
            item.add(this.parseExpressionWithAssign());
            cascade.add(item);
        }

        return cascade;
    }

    // Expression, optionally followed by `= rhs` in case ExpressionParser does not handle assignments itself
    private Node parseExpressionWithAssign() {
        Node expression = ExpressionParser(this.state).parse();

        if (this.state.checkSymbol("=")) {
            Token token = this.state.advance();
            Node assign = this.state.nodeAt(token, "assign", "");
            assign.add(expression);
            assign.add(ExpressionParser(this.state).parse());
            return assign;
        }

        return expression;
    }

    // ---------------------------------------------------------------
    // Ausdrucks-Statement
    // ---------------------------------------------------------------

    private Node parseExpressionStatement() {
        Token start = this.state.peek();
        Node expression = this.absorbCascade(this.parseExpressionWithAssign());
        Node statement = this.state.nodeAt(start, "expr-stmt", "");
        statement.add(expression);
        return statement;
    }

    // ---------------------------------------------------------------
    // Lokale Deklarationen
    // ---------------------------------------------------------------

    private Bool atLocalStart() {
        Token token = this.state.peek();

        if (this.isWord(token, "final") || this.isWord(token, "scoped") || this.isWord(token, "var")) {
            return true;
        }

        if (this.isWord(token, "dynamic") && this.state.peekAt(1).kindIs("identifier")) {
            return true;
        }

        if (!token.kindIs("identifier") && !token.isSymbol("[")) {
            return false;
        }

        // Speculative: a type followed by an identifier is a declaration
        Int start = this.state.position();
        this.state.beginSpeculation();
        TypeParser(this.state).parse();
        Bool parsed = this.state.endSpeculation();
        Bool declaration = parsed && this.atDeclarationName();
        this.state.seek(start);
        return declaration;
    }

    // An identifier, or a keyword (e.g. `exception`) as a variable name when it is followed by
    // `=`, `;` or a line break. Control-flow keywords are never names.
    private Bool atDeclarationName() {
        Token token = this.state.peek();

        if (token.kindIs("identifier")) {
            return true;
        }

        if (!this.isNameKeyword(token)) {
            return false;
        }

        Token next = this.state.peekAt(1);
        return next.isSymbol("=") || next.isSymbol(";") || next.line() != token.line() || next.kindIs("eof");
    }

    private Bool isNameKeyword(Token token) {
        if (!token.kindIs("keyword")) {
            return false;
        }

        String text = token.text();
        return text == "exception" || text == "method" || text == "macro" || text == "record" || text == "class" || text == "interface" || text == "enum" || text == "package" || text == "use";
    }

    private Node parseLocal() {
        Token start = this.state.peek();
        List<Node> modifiers = List();

        while (this.isWord(this.state.peek(), "final") || this.isWord(this.state.peek(), "scoped")) {
            Token modifier = this.state.advance();
            modifiers.add(this.state.nodeAt(modifier, "modifier", modifier.text()));
        }

        if (this.isWord(this.state.peek(), "var")) {
            Token varToken = this.state.advance();

            if (this.state.checkSymbol("{")) {
                return this.parseDestructure(start, modifiers);
            }

            return this.finishLocal(start, modifiers, this.state.nodeAt(varToken, "var", "var"));
        }

        if (this.isWord(this.state.peek(), "dynamic") && this.state.peekAt(1).kindIs("identifier")) {
            Token dynamicToken = this.state.advance();
            return this.finishLocal(start, modifiers, this.state.nodeAt(dynamicToken, "type", "dynamic"));
        }

        return this.finishLocal(start, modifiers, TypeParser(this.state).parse());
    }

    private Node finishLocal(Token start, List<Node> modifiers, Node typeNode) {
        Token nameToken = this.consumeName("Expected variable name");
        Node local = this.state.nodeAt(start, "local", nameToken.text());
        Int index = 0;

        while (index < modifiers.length()) {
            local.add(modifiers.get(index));
            index = index + 1;
        }

        local.add(typeNode);

        if (this.state.checkSymbol("=")) {
            Token assign = this.state.advance();
            Node init = this.state.nodeAt(assign, "init", "");
            Node value = ExpressionParser(this.state).parse();
            init.add(this.absorbCascade(value));
            local.add(init);
        }

        return local;
    }

    private Node parseDestructure(Token start, List<Node> modifiers) {
        Node node = this.state.nodeAt(start, "destructure", "");
        Int index = 0;

        while (index < modifiers.length()) {
            node.add(modifiers.get(index));
            index = index + 1;
        }

        this.state.consumeSymbol("{", "Expected '{' in destructuring");

        while (!this.state.isAtEnd() && !this.state.checkSymbol("}")) {
            Int before = this.state.position();
            node.add(this.parseBinding());

            if (!this.state.matchSymbol(",")) {
                break;
            }

            if (this.state.position() == before) {
                this.state.advance();
            }
        }

        this.state.consumeSymbol("}", "Expected '}' after destructuring names");
        Token assign = this.state.consumeSymbol("=", "Expected '=' in destructuring");
        Node init = this.state.nodeAt(assign, "init", "");
        Node value = ExpressionParser(this.state).parse();
        init.add(this.absorbCascade(value));
        node.add(init);
        return node;
    }

    // Names may also be keywords (e.g. `exception` in `error(exception)`)
    private Token consumeName(String message) {
        if (this.state.peek().kindIs("keyword")) {
            return this.state.advance();
        }

        return this.state.consumeKind("identifier", message);
    }

    private Node parseBinding() {
        Token token = this.consumeName("Expected a name");

        if (token.text() == "_") {
            return this.state.nodeAt(token, "wildcard", "_");
        }

        return this.state.nodeAt(token, "binding", token.text());
    }

    // ---------------------------------------------------------------
    // Kontrollfluss
    // ---------------------------------------------------------------

    private Node parseIf() {
        Token start = this.state.advance();
        Node node = this.state.nodeAt(start, "if", "");
        node.add(this.parseCondition());
        node.add(this.parseBody());

        if (this.isWord(this.state.peek(), "else")) {
            this.state.errorHere("'else' is not supported, use guard clauses");
            Token elseToken = this.state.advance();
            Node elseNode = this.state.nodeAt(elseToken, "else", "");
            elseNode.add(this.parseBody());
            node.add(elseNode);
        }

        return node;
    }

    private Node parseWhile() {
        Token start = this.state.advance();
        Node node = this.state.nodeAt(start, "while", "");
        node.add(this.parseCondition());
        node.add(this.parseBody());
        return node;
    }

    private Bool atForeach() {
        Int start = this.state.position();
        this.state.beginSpeculation();

        if (this.isWord(this.state.peek(), "final")) {
            this.state.advance();
        }

        if (this.isWord(this.state.peek(), "var")) {
            this.state.advance();
        } else {
            TypeParser(this.state).parse();
        }

        Bool parsed = this.state.endSpeculation();
        Bool result = parsed && (this.state.peek().kindIs("identifier") || this.isNameKeyword(this.state.peek())) && this.isWord(this.state.peekAt(1), "in");
        this.state.seek(start);
        return result;
    }

    private Node parseFor() {
        Token start = this.state.advance();
        this.state.consumeSymbol("(", "Expected '(' after 'for'");

        if (this.atForeach()) {
            return this.parseForeach(start);
        }

        Node node = this.state.nodeAt(start, "for", "");
        Node init = this.state.node("init", "");

        if (!this.state.checkSymbol(";")) {
            init.add(this.parseSimpleStatement());
        }

        this.state.consumeSymbol(";", "Expected ';' after for initializer");
        node.add(init);

        Node condition = this.state.node("condition", "");

        if (!this.state.checkSymbol(";")) {
            condition.add(ExpressionParser(this.state).parse());
        }

        this.state.consumeSymbol(";", "Expected ';' after for condition");
        node.add(condition);

        Node update = this.state.node("update", "");

        if (!this.state.checkSymbol(")")) {
            update.add(this.parseExpressionWithAssign());

            while (this.state.matchSymbol(",")) {
                update.add(this.parseExpressionWithAssign());
            }
        }

        this.state.consumeSymbol(")", "Expected ')' after for clauses");
        node.add(update);
        node.add(this.parseBody());
        return node;
    }

    private Node parseForeachType() {
        Token first = this.state.peek();

        if (this.isWord(first, "var")) {
            this.state.advance();
            return this.state.nodeAt(first, "var", "var");
        }

        return TypeParser(this.state).parse();
    }

    private Node parseForeach(Token start) {
        if (this.isWord(this.state.peek(), "final")) {
            this.state.advance();
        }

        Node typeNode = this.parseForeachType();
        Token name = this.consumeName("Expected loop variable name");

        if (this.isWord(this.state.peek(), "in")) {
            this.state.advance();
        } else {
            this.state.errorHere("Expected 'in'");
        }

        Node node = this.state.nodeAt(start, "foreach", name.text());
        node.add(typeNode);
        node.add(ExpressionParser(this.state).parse());
        this.state.consumeSymbol(")", "Expected ')' after for-in clause");
        node.add(this.parseBody());
        return node;
    }

    private Node parseReturn() {
        Token start = this.state.advance();
        Node node = this.state.nodeAt(start, "return", "");
        Token next = this.state.peek();

        if (next.kindIs("eof") || next.isSymbol("}") || next.isSymbol(";")) {
            return node;
        }

        if (next.line() != start.line()) {
            return node;
        }

        node.add(this.absorbCascade(ExpressionParser(this.state).parse()));
        return node;
    }

    private Node parseValueStatement(String kind) {
        Token start = this.state.advance();
        Node node = this.state.nodeAt(start, kind, "");
        node.add(ExpressionParser(this.state).parse());
        return node;
    }

    // ---------------------------------------------------------------
    // switch
    // ---------------------------------------------------------------

    private Node parseSwitch() {
        Token start = this.state.advance();
        Node node = this.state.nodeAt(start, "switch", "");
        node.add(this.parseCondition());
        this.state.consumeSymbol("{", "Expected '{' after switch subject");

        while (!this.state.isAtEnd() && !this.state.checkSymbol("}")) {
            Int before = this.state.position();
            node.add(this.parseCase());

            if (this.state.checkSymbol(",") || this.state.checkSymbol(";")) {
                this.state.advance();
            }

            if (this.state.position() == before) {
                this.state.advance();
            }
        }

        this.state.consumeSymbol("}", "Expected '}' after switch cases");
        return node;
    }

    private Node parseCase() {
        Token start = this.state.peek();
        Node node = this.state.nodeAt(start, "case", "");
        node.add(this.parsePattern());

        while (this.state.checkSymbol(",")) {
            this.state.advance();
            node.add(this.parsePattern());
        }

        this.state.consumeSymbol("->", "Expected '->' after switch pattern");
        node.add(this.parseSimpleStatement());
        return node;
    }

    private Node parsePattern() {
        Token token = this.state.peek();

        if (this.isWord(token, "success")) {
            this.state.advance();
            Node success = this.state.nodeAt(token, "pattern-success", "");

            if (this.state.matchSymbol("(")) {
                success.add(this.parseBinding());
                this.state.consumeSymbol(")", "Expected ')' after success binding");
            }

            return success;
        }

        if (this.isWord(token, "error")) {
            this.state.advance();
            Node error = this.state.nodeAt(token, "pattern-error", "");

            if (this.state.matchSymbol("(")) {
                if (!this.state.peekAt(1).isSymbol(")")) {
                    error.add(TypeParser(this.state).parse());
                }

                error.add(this.parseBinding());
                this.state.consumeSymbol(")", "Expected ')' after error binding");
            }

            return error;
        }

        if (token.kindIs("identifier") && (this.state.peekAt(1).isSymbol("->") || this.state.peekAt(1).isSymbol(","))) {
            this.state.advance();
            return this.state.nodeAt(token, "pattern-name", token.text());
        }

        Node value = this.state.nodeAt(token, "pattern-value", "");
        value.add(ExpressionParser(this.state).parse());
        return value;
    }
}
