namespace ring0::syntax;

use ring0::syntax::Node;
use ring0::syntax::ParserState;
use ring0::syntax::Token;
use ring0::syntax::TopLevelParser;
use ring0::diagnostic::DiagnosticBag;

// Entry point: tokens -> "file" node (see TopLevelParser).
public class Parser {
    private ParserState state;

    public Parser(List<Token> tokens, DiagnosticBag bag) {
        this.state = ParserState(tokens, bag);
    }

    public Node parse() {
        TopLevelParser top = TopLevelParser(this.state);
        return top.parseFile();
    }
}
