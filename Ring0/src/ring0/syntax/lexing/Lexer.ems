namespace ring0::syntax;

use ring0::syntax::LexerCursor;
use ring0::syntax::LexerRules;
use ring0::syntax::LexerTokenReader;
use ring0::syntax::Token;

use ring0::diagnostic::DiagnosticBag;

public class Lexer {
    private LexerCursor cursor;
    private LexerRules rules;
    private LexerTokenReader reader;
    private DiagnosticBag diagnostics;

    public Lexer(String text, DiagnosticBag bag) {
        this.cursor = LexerCursor(text);
        this.rules = LexerRules();
        this.reader = LexerTokenReader(this.cursor, this.rules, bag);
        this.diagnostics = bag;
    }

    public List<Token> tokenize() {
        List<Token> tokens = List();

        while (!this.cursor.isAtEnd()) {
            this.scanToken(tokens);
        }

        tokens.add(Token("eof", "", this.cursor.line(), this.cursor.column()));
        return tokens;
    }

    private Void scanToken(List<Token> tokens) {
        String value = this.cursor.peekText();
        String next = this.cursor.peekNextText();

        if (this.rules.isWhitespace(value)) {
            this.cursor.advanceText();
            return;
        }

        if (value == "/" && next == "/") {
            this.reader.skipLineComment();
            return;
        }

        if (value == "/" && next == "*") {
            this.reader.skipBlockComment();
            return;
        }

        if (this.rules.isIdentifierStart(value)) {
            tokens.add(this.reader.readIdentifier());
            return;
        }

        if (this.rules.isDigit(value)) {
            tokens.add(this.reader.readNumber());
            return;
        }

        if (value == "\"") {
            tokens.add(this.reader.readString());
            return;
        }

        Int line = this.cursor.line();
        Int column = this.cursor.column();
        String third = this.cursor.peekAt(2);

        if (this.rules.isThreeCharacterSymbol(value, next, third)) {
            tokens.add(Token("symbol", value + next + third, line, column));
            this.cursor.advanceText();
            this.cursor.advanceText();
            this.cursor.advanceText();
            return;
        }

        if (this.rules.isTwoCharacterSymbol(value, next)) {
            tokens.add(Token("symbol", value + next, line, column));
            this.cursor.advanceText();
            this.cursor.advanceText();
            return;
        }

        if (this.rules.isSymbol(value)) {
            tokens.add(Token("symbol", value, line, column));
            this.cursor.advanceText();
            return;
        }

        this.diagnostics.error("Unexpected character '" + value + "'", line, column);
        this.cursor.advanceText();
    }
}
