namespace ring0::syntax;

// Der Projektlader löst Klassen nur über `use` auf. Dieser Prelude listet alle Klassen des
// Frontends, damit sich die Parser (zyklisch voneinander abhängig) ohne eigene `use`-Zeilen
// finden. Main bindet nur diese Datei ein: `use ring0::syntax::SyntaxPrelude;`.
use ring0::diagnostic::Diagnostic;
use ring0::diagnostic::DiagnosticBag;
use ring0::syntax::Token;
use ring0::syntax::Node;
use ring0::syntax::ParserState;
use ring0::syntax::Lexer;
use ring0::syntax::LexerCursor;
use ring0::syntax::LexerRules;
use ring0::syntax::LexerTokenReader;
use ring0::syntax::TypeParser;
use ring0::syntax::ExpressionParser;
use ring0::syntax::StatementParser;
use ring0::syntax::DeclHeaderParser;
use ring0::syntax::DeclMemberParser;
use ring0::syntax::TopLevelParser;
use ring0::syntax::Parser;

public class SyntaxPrelude {
    public SyntaxPrelude() {
    }
}
