namespace ring0::lowering;

use ring0::binding::AstQuery;
use ring0::syntax::Node;

// Lowers statements. Every method returns true when control cannot continue past the
// statement (return, break, continue), so unreachable code is not emitted.
public class StatementLowerer {
    private LoweringContext context;

    public StatementLowerer(LoweringContext loweringContext) {
        this.context = loweringContext;
    }

    public Bool lowerBlock(Node block) {
        Int mark = this.context.env().size();
        Bool terminated = false;
        Int index = 0;

        while (index < block.count() && !terminated) {
            terminated = this.lowerStatement(block.child(index));
            index = index + 1;
        }

        this.context.env().truncate(mark);
        return terminated;
    }

    public Bool lowerStatement(Node node) {
        String kind = node.kind();

        if (kind == "local") {
            return this.lowerLocal(node);
        }

        if (kind == "expr-stmt") {
            return this.lowerExpressionStatement(node.child(0));
        }

        if (kind == "return") {
            return this.lowerReturn(node);
        }

        if (kind == "if") {
            return BranchLowerer(this.context).lowerIf(node);
        }

        if (kind == "while") {
            return LoopLowerer(this.context).lowerWhile(node);
        }

        if (kind == "for") {
            return LoopLowerer(this.context).lowerFor(node);
        }

        if (kind == "break" || kind == "continue") {
            return this.lowerJump(node);
        }

        if (kind == "block") {
            return this.lowerBlock(node);
        }

        this.context.unsupported(node, "statement '" + kind + "' is not part of the prototype subset");
        return false;
    }

    public Bool lowerExpressionStatement(Node expression) {
        String kind = expression.kind();

        if (kind == "assign") {
            this.lowerAssignment(expression);
            return false;
        }

        if (kind == "postfix") {
            this.lowerStep(expression);
            return false;
        }

        ExpressionLowerer(this.context).lower(expression);
        return false;
    }

    private Bool lowerLocal(Node node) {
        Node init = AstQuery.childOfKind(node, "init");

        if (AstQuery.isNone(init) || init.count() == 0) {
            this.context.unsupported(node, "local '" + node.text() + "' needs an initializer");
            return false;
        }

        LoweredValue value = ExpressionLowerer(this.context).lower(init.child(0));

        if (!value.isUsable()) {
            return false;
        }

        this.context.env().declare(node.text(), value.valueId(), value.kind());
        return false;
    }

    private Void lowerAssignment(Node node) {
        Node target = node.child(0);
        Int slot = this.context.env().indexOf(target.text());

        if (target.kind() != "name" || slot < 0) {
            this.context.unsupported(node, "assignment target must be a local variable");
            return;
        }

        LoweredValue assigned = this.combine(node, slot, ExpressionLowerer(this.context).lower(node.child(1)));

        if (assigned.isUsable()) {
            this.context.env().setValueAt(slot, assigned.valueId());
        }
    }

    // `x op= y` folds into `x = x op y`; plain `=` passes the value through.
    private LoweredValue combine(Node node, Int slot, LoweredValue value) {
        if (node.text() == "=" || !value.isUsable()) {
            return value;
        }

        LoweredValue current = LoweredValue(this.context.env().valueAt(slot), this.context.env().kindAt(slot));
        String operator = node.text().substring(0, node.text().length() - 1);
        return OperatorLowerer(this.context).apply(node, operator, current, value);
    }

    // `i++` and `i--` as statements: i = i +/- 1.
    private Void lowerStep(Node node) {
        Node target = node.child(0);
        Int slot = this.context.env().indexOf(target.text());

        if (target.kind() != "name" || slot < 0) {
            this.context.unsupported(node, "'" + node.text() + "' needs a local variable");
            return;
        }

        LoweredValue current = LoweredValue(this.context.env().valueAt(slot), this.context.env().kindAt(slot));
        Int one = this.context.builder().ops().constInt(1, this.context.span(node));
        String operator = "+";

        if (node.text() == "--") {
            operator = "-";
        }

        LoweredValue next = OperatorLowerer(this.context).apply(node, operator, current, LoweredValue(one, "Int"));

        if (next.isUsable()) {
            this.context.env().setValueAt(slot, next.valueId());
        }
    }

    private Bool lowerReturn(Node node) {
        Int value = 0;

        if (node.count() > 0) {
            LoweredValue result = ExpressionLowerer(this.context).lower(node.child(0));

            if (!result.isUsable()) {
                return true;
            }

            value = result.valueId();
        }

        this.context.builder().ops().returnValue(value, this.context.span(node));
        return true;
    }

    private Bool lowerJump(Node node) {
        Int depth = this.context.frames().length();

        if (depth == 0) {
            this.context.unsupported(node, "'" + node.kind() + "' outside of a loop");
            return true;
        }

        LoopFrame frame = this.context.frames().get(depth - 1);
        Int target = frame.continueTarget();

        if (node.kind() == "break") {
            target = frame.breakTarget();
        }

        List<Int> values = CarriedVariables.currentValues(this.context, frame.carriedIndices());
        this.context.builder().ops().branchTo(target, values, this.context.span(node));
        return true;
    }
}
