namespace ring0::lowering;

use ring0::syntax::Node;
use sublang::ir::SublangBuilder;

// `while` and `for`. Loop-carried variables become header block parameters; `break`
// and `continue` pass the current values to the exit / continue block.
public class LoopLowerer {
    private LoweringContext context;

    public LoopLowerer(LoweringContext loweringContext) {
        this.context = loweringContext;
    }

    public Bool lowerWhile(Node node) {
        List<Node> parts = List();
        parts.add(node.child(0));
        parts.add(node.child(1));
        List<Int> carried = CarriedVariables.select(this.context, parts);
        SublangBuilder builder = this.context.builder();
        Int header = builder.newBlock();
        Int exit = builder.newBlock();
        this.enterLoop(node, header, carried);
        this.lowerCondition(node, node.child(0), exit, carried);
        this.lowerBody(node.child(1), header, exit, header, carried);
        this.leaveLoop(exit, carried);
        return false;
    }

    // children: init, condition (0 or 1 expression), update, body block
    public Bool lowerFor(Node node) {
        Int mark = this.context.env().size();
        Node init = node.child(0);
        Int index = 0;

        while (index < init.count()) {
            StatementLowerer(this.context).lowerStatement(init.child(index));
            index = index + 1;
        }

        List<Node> parts = List();
        parts.add(node.child(1));
        parts.add(node.child(2));
        parts.add(node.child(3));
        List<Int> carried = CarriedVariables.select(this.context, parts);
        SublangBuilder builder = this.context.builder();
        Int header = builder.newBlock();
        Int update = builder.newBlock();
        Int exit = builder.newBlock();
        this.enterLoop(node, header, carried);
        this.lowerCondition(node, node.child(1), exit, carried);
        this.lowerBody(node.child(3), update, exit, update, carried);
        builder.enterBlock(update);
        CarriedVariables.bindParameters(this.context, carried);
        this.lowerUpdates(node.child(2));
        builder.ops().branchTo(header, CarriedVariables.currentValues(this.context, carried), this.context.span(node));
        this.leaveLoop(exit, carried);
        this.context.env().truncate(mark);
        return false;
    }

    private Void enterLoop(Node node, Int header, List<Int> carried) {
        SublangBuilder builder = this.context.builder();
        builder.ops().branchTo(header, CarriedVariables.currentValues(this.context, carried), this.context.span(node));
        builder.enterBlock(header);
        CarriedVariables.bindParameters(this.context, carried);
    }

    // `condition` is the expression itself for while, a wrapper with 0 or 1 child for for.
    private Void lowerCondition(Node loop, Node condition, Int exit, List<Int> carried) {
        SublangBuilder builder = this.context.builder();
        Int span = this.context.span(loop);
        LoweredValue value = ExpressionLowerer(this.context).lower(this.conditionNode(loop, condition));
        Int body = builder.newBlock();
        List<Int> none = List();

        if (value.kind() != "Bool") {
            this.context.unsupported(loop, "loop condition must be Bool");
            return;
        }

        builder.ops().condBranch(value.valueId(), body, none, exit, CarriedVariables.currentValues(this.context, carried), span);
        builder.enterBlock(body);
    }

    // while: the expression itself; for: a wrapper with 0 or 1 child, empty means `true`.
    private Node conditionNode(Node loop, Node condition) {
        if (loop.kind() == "while") {
            return condition;
        }

        if (condition.count() > 0) {
            return condition.child(0);
        }

        return Node("bool-literal", "true", loop.line(), loop.column());
    }

    private Void lowerBody(Node body, Int continueTarget, Int exit, Int next, List<Int> carried) {
        this.context.frames().add(LoopFrame(continueTarget, exit, carried));
        Bool terminated = StatementLowerer(this.context).lowerBlock(body);

        if (!terminated) {
            this.context.builder().ops().branchTo(next, CarriedVariables.currentValues(this.context, carried), this.context.span(body));
        }

        this.context.frames().removeAt(this.context.frames().length() - 1);
    }

    private Void lowerUpdates(Node update) {
        Int index = 0;

        while (index < update.count()) {
            StatementLowerer(this.context).lowerExpressionStatement(update.child(index));
            index = index + 1;
        }
    }

    private Void leaveLoop(Int exit, List<Int> carried) {
        this.context.builder().enterBlock(exit);
        CarriedVariables.bindParameters(this.context, carried);
    }
}
