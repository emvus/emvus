namespace ring0::lowering;

use ring0::syntax::Node;

// Decides before a function body is emitted whether it needs the function-level text scope.
// The scope must begin in the entry block so it dominates every later text allocation.
public class TextUsage {
    public TextUsage() {
    }

    // True when the tree calls a member named `indexOf`; the search helper is then created with the
    // other text helpers, before any user function. (A List.indexOf also matches: the helper is unused.)
    public static Bool callsIndexOf(Node node) {
        if (node.kind() == "member" && node.text() == "indexOf") {
            return true;
        }

        Int index = 0;

        while (index < node.count()) {
            if (TextUsage.callsIndexOf(node.child(index))) {
                return true;
            }

            index = index + 1;
        }

        return false;
    }

    public static Bool isUsedIn(Node node) {
        if (node.kind() == "string" || node.type() == "String") {
            return true;
        }

        if (node.kind() == "type" && node.text() == "String") {
            return true;
        }

        Int index = 0;

        while (index < node.count()) {
            if (TextUsage.isUsedIn(node.child(index))) {
                return true;
            }

            index = index + 1;
        }

        return false;
    }
}
