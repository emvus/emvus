// Value records with primitive fields: construction, field reads, parameters and returns.
record Point(Int x, Int y)

method<Int> manhattan(Point a, Point b) {
    Int dx = b.x - a.x
    Int dy = b.y - a.y

    if (dx < 0) {
        dx = -dx
    }

    if (dy < 0) {
        dy = -dy
    }

    return dx + dy
}

method<Point> midpoint(Point a, Point b) {
    return Point((a.x + b.x) / 2, (a.y + b.y) / 2)
}

static method<Int> main {
    Point origin = Point(0, 0)
    Point corner = Point(8, -6)
    Point middle = midpoint(origin, corner)
    return manhattan(origin, corner) * 100 + middle.x * 10 + middle.y
}
