// `as`: an upcast keeps the object, a downcast to a class without descendants is exact.
class Animal {
    method<Int> legs {
        return 4
    }
}

class Dog based Animal {
    method<Int> bark {
        return 7
    }
}

static method<Int> main {
    Animal animal = Dog()
    Dog dog = animal as Dog
    return dog.bark() + animal.legs()
}
