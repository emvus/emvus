// expect-status: 5
// readFile, writeFile and argument: copy the file named by the first argument to the second.
static method<Int> main {
    String missing = readFile("/nonexistent/emvus-test-file")

    if (missing.length() != 0) {
        return 1
    }

    String source = argument(0)
    String target = argument(1)
    String content = readFile(source)

    if (!writeFile(target, content + "!")) {
        return 2
    }

    println(readFile(target))
    return 5
}
