// Forward references: isEven calls isOdd before isOdd is declared.
method<Bool> isEven(Int n) {
    if (n == 0) {
        return true
    }

    return isOdd(n - 1)
}

method<Bool> isOdd(Int n) {
    if (n == 0) {
        return false
    }

    return isEven(n - 1)
}

static method<Int> main {
    if (isEven(10) && isOdd(7)) {
        return 1
    }

    return 0
}
